---
/**
 * A page of the developer documentation: the site's header and footer, the pages on the left, the
 * page's text in the middle, its sections on the right (wide screens).
 */
import { getCollection, render } from "astro:content";
import { ArrowLeft, ArrowRight, ArrowUpRight, Check, ChevronDown, Copy } from "lucide-react";
import Dither from "@/components/Dither.astro";
import DocsNav from "@/components/DocsNav.astro";
import Nestor from "@/components/Nestor.astro";
import { LOCALES, type Locale, translator } from "@/i18n";
import Base from "@/layouts/Base.astro";
import { docHref, neighbours, parseDocId } from "@/lib/docs";
import { REPOS } from "@/lib/site";

interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const t = translator(locale);

const entries = await getCollection("docs", (entry) => parseDocId(entry.id).locale === locale);
const titles = Object.fromEntries(entries.map((entry) => [parseDocId(entry.id).slug, entry.data.title]));
const entry = entries.find((e) => parseDocId(e.id).slug === slug);
if (!entry) throw new Error(`[docs] no ${locale} page for "${slug}"`);
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2);
const { previous, next } = neighbours(slug);
const alternates = Object.fromEntries(LOCALES.map((l) => [l, docHref(l, slug)])) as Record<Locale, string>;
const edit = `${REPOS.web}/edit/main/${entry.filePath}`;
---

<Base
  locale={locale}
  alternates={alternates}
  title={t("docs-meta-title", { title: entry.data.title })}
  description={entry.data.description}
  card="docs"
  dock={false}
>
  <div class="wrap docs-grid pt-8 pb-20 lg:pt-12">
    <aside class="docs-side hidden lg:block">
      <div class="sticky top-20 max-h-[calc(100dvh-6rem)] overflow-y-auto pr-2 pb-8">
        <DocsNav t={t} slug={slug} titles={titles} />
      </div>
    </aside>

    <article class="docs-article">
      <details class="docs-menu mb-8 border-y border-rule lg:hidden">
        <summary class="flex cursor-pointer items-center justify-between py-3 text-[0.95rem] text-ink">
          {t("docs-menu")}
          <ChevronDown className="docs-menu-icon size-4 text-ink-muted" strokeWidth={1.6} aria-hidden="true" />
        </summary>
        <div class="pb-5">
          <DocsNav t={t} slug={slug} titles={titles} />
        </div>
      </details>

      <header class="flex items-start justify-between gap-6">
        <div class="min-w-0">
          <h1 class="docs-title text-ink">{entry.data.title}</h1>
          <p class="lede mt-4">{entry.data.description}</p>
        </div>
        {slug === "" && <Nestor size={96} state="idle" look="left" ground class="hidden shrink-0 sm:block" label={t("nestor-label")} />}
      </header>

      <div class="doc-prose mt-10">
        <Content />
      </div>

      <footer class="mt-16 border-t border-rule pt-6">
        <div class="grid gap-3 sm:grid-cols-2">
          {
            previous !== undefined && (
              <a href={docHref(locale, previous)} rel="prev" class="docs-step group flex flex-col gap-1 border border-rule p-4">
                <span class="flex items-center gap-1.5 font-mono text-[0.72rem] text-ink-muted">
                  <ArrowLeft className="size-3.5" strokeWidth={1.6} aria-hidden="true" />
                  {t("docs-previous")}
                </span>
                <span class="text-ink group-hover:text-ember">{titles[previous]}</span>
              </a>
            )
          }
          {
            next !== undefined && (
              <a href={docHref(locale, next)} rel="next" class="docs-step group flex flex-col items-end gap-1 border border-rule p-4 text-right sm:col-start-2">
                <span class="flex items-center gap-1.5 font-mono text-[0.72rem] text-ink-muted">
                  {t("docs-next")}
                  <ArrowRight className="size-3.5" strokeWidth={1.6} aria-hidden="true" />
                </span>
                <span class="text-ink group-hover:text-ember">{titles[next]}</span>
              </a>
            )
          }
        </div>
        <p class="mt-6">
          <a href={edit} class="link inline-flex items-center gap-1 font-mono text-[0.75rem] text-ink-muted">
            {t("docs-edit")}
            <ArrowUpRight className="size-3.5" strokeWidth={1.6} aria-hidden="true" />
          </a>
        </p>
      </footer>
      <Dither shape="ramp-right" from={0} to={0.35} dot={2} class="mt-12 h-8 w-full text-ink/15" />
    </article>

    {
      sections.length > 1 && (
        <aside class="docs-toc hidden xl:block">
          <nav class="sticky top-20" aria-label={t("docs-toc")}>
            <p class="label-mono">{t("docs-toc")}</p>
            <ul class="mt-3 flex flex-col gap-1 text-[0.85rem]">
              {sections.map((section) => (
                <li>
                  <a href={`#${section.slug}`} data-nav={section.slug} class="toc-link block py-1 text-ink-muted hover:text-ink">
                    {section.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }
  </div>
  <template id="doc-copy">
    <button type="button" class="doc-copy" data-copied={t("copied")}>
      <Copy className="copy-idle size-3.5" strokeWidth={1.6} aria-hidden="true" />
      <Check className="copy-done size-3.5" strokeWidth={1.6} aria-hidden="true" />
      <span data-copy-label aria-live="polite">{t("copy")}</span>
    </button>
  </template>
  <script>
    import "@/scripts/docs";
  </script>
</Base>

<style>
  .docs-grid {
    display: grid;
    gap: 2.5rem;
  }
  .docs-grid > * {
    min-width: 0;
  }
  @media (min-width: 64rem) {
    .docs-grid {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: 3rem;
    }
  }
  @media (min-width: 80rem) {
    .docs-grid {
      grid-template-columns: 13rem minmax(0, 1fr) 12rem;
    }
  }
  .docs-article {
    max-width: 46rem;
  }
  .docs-title {
    font-size: clamp(2.1rem, 4.4vw, 3.2rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }
  .docs-menu summary {
    list-style: none;
  }
  .docs-menu summary::-webkit-details-marker {
    display: none;
  }
  .docs-menu[open] :global(.docs-menu-icon) {
    transform: rotate(180deg);
  }
  .docs-step {
    transition: border-color var(--duration) var(--ease);
  }
  .docs-step:hover {
    border-color: var(--rule-strong);
  }
  .toc-link[data-active] {
    color: var(--ink);
  }
</style>
