---
/**
 * The film of a day in a home that runs Nestor: muted, inline, played only while on screen (and never by
 * itself under reduced motion), its poster as the still. One picture for both themes: it paints its own sky.
 */
import { Pause, Play } from "lucide-react";
import type { Translator } from "@/i18n";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
---

<figure class="film">
  <div class="relative">
    <video
      id="film"
      data-autoplay
      controls
      muted
      loop
      playsinline
      preload="none"
      poster="/media/film.poster.webp"
      width="1280"
      height="720"
      aria-label={t("film-label")}
      class="block h-auto w-full"
    >
      <source src="/media/film.mp4" type="video/mp4" />
      <source src="/media/film.webm" type="video/webm" />
    </video>
    <button type="button" data-video-toggle aria-controls="film" aria-pressed="true" class="film-toggle">
      <Play className="film-play size-4" strokeWidth={1.6} aria-hidden="true" />
      <Pause className="film-pause size-4" strokeWidth={1.6} aria-hidden="true" />
      <span class="sr-only">{t("video-pause")}</span>
    </button>
  </div>
  <figcaption class="mt-3 text-sm text-ink-muted">{t("film-caption")}</figcaption>
</figure>

<style>
  .film > div {
    overflow: hidden;
    border-radius: var(--radius-scene);
    background: #121027;
    box-shadow: var(--lift);
  }
  .film-toggle {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 999px;
    background: rgb(16 14 11 / 0.6);
    color: #f5f0e6;
    backdrop-filter: blur(6px);
  }
  .film-toggle:hover {
    background: rgb(16 14 11 / 0.8);
  }
  .film-toggle[aria-pressed="false"] :global(.film-play),
  .film-toggle[aria-pressed="true"] :global(.film-pause) {
    display: none;
  }
</style>
