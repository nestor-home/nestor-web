---
/** The bow tie as a small mark: list markers and dividers. Used sparingly. */
import { renderBowTie } from "@nestor-home/character";
import "@nestor-home/character/nestor.css";

interface Props {
  size?: number;
  class?: string;
}
const { size = 12, class: className } = Astro.props;
---

<Fragment set:html={renderBowTie({ size, ...(className ? { className } : {}) })} />
