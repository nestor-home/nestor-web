---
/** A third-party mark in the current ink; named for screen readers unless the text beside it already is. */
import { BRANDS, type Brand, type BrandKey } from "@/lib/brands";

interface Props {
  brand: BrandKey;
  class?: string;
  decorative?: boolean;
}
const { brand, class: className = "size-4", decorative = false } = Astro.props;
const { name, path, glyph: Glyph } = BRANDS[brand] as Brand;
---

{
  Glyph ? (
    <Glyph
      className={`shrink-0 ${className}`}
      strokeWidth={1.6}
      role={decorative ? undefined : "img"}
      aria-label={decorative ? undefined : name}
      aria-hidden={decorative ? "true" : undefined}
    />
  ) : (
    <svg
      viewBox="0 0 24 24"
      class:list={["shrink-0 fill-current", className]}
      role={decorative ? undefined : "img"}
      aria-label={decorative ? undefined : name}
      aria-hidden={decorative ? "true" : undefined}
    >
      <path d={path} />
    </svg>
  )
}
