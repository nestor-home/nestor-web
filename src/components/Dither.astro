---
/**
 * The dither texture as a canvas, drawn by the site script (static, redrawn on resize and theme).
 * The canvas fills a box sized by the classes given, so its own pixel size never feeds back into
 * the layout.
 */
import type { DitherShape } from "@/character/dither";

interface Props {
  shape?: DitherShape;
  from?: number;
  to?: number;
  dot?: number;
  class?: string;
}
const { shape = "ramp-right", from = 0, to = 0.6, dot = 2, class: className = "" } = Astro.props;
const positioned = /\b(absolute|fixed)\b/.test(className);
---

<div aria-hidden="true" class:list={["pointer-events-none", !positioned && "relative", className]}>
  <canvas
    data-dither
    data-shape={shape}
    data-from={from}
    data-to={to}
    data-dot={dot}
    class="absolute inset-0 block h-full w-full"></canvas>
</div>
