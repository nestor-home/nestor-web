---
/** What one says to a satellite in a room: the room, the voice as it comes, the words heard, and the answer. */
import Brand from "@/components/Brand.astro";
import Nestor from "@/components/Nestor.astro";
import type { Translator } from "@/i18n";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
// a phrase's shape: louder in the middle, quiet at the ends
const bars = [3, 5, 8, 12, 9, 14, 18, 13, 20, 16, 22, 17, 12, 19, 15, 10, 13, 8, 11, 6, 9, 5, 4, 3];
---

<figure class="obj spoken" data-reveal>
  <figcaption class="spoken-room">
    <Brand brand="satellites" class="size-4" decorative />
    <span>{t("story-ask-room")}</span>
    <span class="ml-auto tabular">09:10</span>
  </figcaption>
  <div class="spoken-wave" aria-hidden="true">
    {bars.map((h, i) => <span style={`--h:${h};--i:${i}`} />)}
  </div>
  <p class="spoken-words">{t("story-ask-said")}</p>
  <p class="spoken-who"><span>{t("story-ask-who")}</span></p>
  <p class="spoken-answer">
    <Nestor state="speaking" size={30} class="shrink-0" />
    <span>{t("story-ask-answer")}</span>
  </p>
</figure>

<style>
  .spoken {
    color-scheme: dark;
    width: min(100%, 30rem);
    padding: 1.4rem 1.5rem 1.5rem;
    border-radius: 1.6rem;
    background: radial-gradient(120% 90% at 50% 0%, #2a2219, #15120f 70%);
    color: #f3ecdf;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.06) inset,
      0 30px 60px -30px rgb(20 14 8 / 0.55);
  }
  .spoken-room {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: rgb(243 236 223 / 0.6);
  }
  .spoken-wave {
    display: flex;
    height: 4.5rem;
    align-items: center;
    justify-content: center;
    gap: 0.28rem;
    margin-block: 1.4rem 1.1rem;
  }
  .spoken-wave span {
    width: 0.3rem;
    height: calc(var(--h) * 0.16rem + 0.3rem);
    border-radius: 999px;
    background: var(--ember);
    transform-origin: center;
  }
  .spoken-words {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-align: center;
    text-wrap: balance;
  }
  .spoken-who {
    margin-top: 0.8rem;
    text-align: center;
  }
  .spoken-who span {
    display: inline-block;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    font-size: var(--text-xs);
    color: rgb(243 236 223 / 0.8);
  }
  .spoken-answer {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1.4rem;
    padding: 0.7rem 0.9rem;
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.06);
    font-size: var(--text-sm);
    color: rgb(243 236 223 / 0.85);
  }

  /* when it comes into view: the voice rises, then the words, then the answer */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .spoken[data-shown] .spoken-wave span {
      animation: speak 1.1s ease-in-out calc(var(--i) * 40ms) 3 both;
    }
    :global(.js) .spoken .spoken-words,
    :global(.js) .spoken .spoken-who,
    :global(.js) .spoken .spoken-answer {
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity 500ms var(--ease-out),
        transform 500ms var(--ease-out);
    }
    :global(.js) .spoken[data-shown] .spoken-words,
    :global(.js) .spoken[data-shown] .spoken-who {
      opacity: 1;
      transform: none;
      transition-delay: 600ms;
    }
    :global(.js) .spoken[data-shown] .spoken-answer {
      opacity: 1;
      transform: none;
      transition-delay: 1500ms;
    }
  }
  @keyframes speak {
    0%,
    100% {
      transform: scaleY(1);
    }
    50% {
      transform: scaleY(0.35);
    }
  }
</style>
