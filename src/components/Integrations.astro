---
/**
 * The services Nestor connects to, grouped by what they bring to a household (lib/integrations.ts): each a
 * raised chip led by its logo, in the brand's own colour on hover. What is not shipped yet carries a
 * "planned" badge, part of the item's text.
 */
import Brand from "@/components/Brand.astro";
import Planned from "@/components/Planned.astro";
import type { Translator } from "@/i18n";
import { BRANDS, type Brand as BrandInfo } from "@/lib/brands";
import { INTEGRATIONS } from "@/lib/integrations";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
---

<div class="grid gap-x-10 gap-y-9 md:grid-cols-2">
  {
    INTEGRATIONS.map((g, gi) => (
      <div data-reveal style={`--i:${gi}`}>
        <h3 class="font-medium text-ink">{t(`int-group-${g.group}`)}</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {g.items.map(({ brand, status }) => {
            const { name, hex } = BRANDS[brand] as BrandInfo;
            return (
              <li class="int-item" style={hex ? `--brand:${hex}` : undefined}>
                <Brand brand={brand} class="int-mark size-[1.15rem] shrink-0" decorative />
                <span class="whitespace-nowrap">{name}</span>
                {status === "planned" && <Planned t={t} />}
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .int-item {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    height: 2.5rem;
    padding-inline: 0.85rem;
    border-radius: 999px;
    background: var(--paper-raised);
    box-shadow: var(--lift);
    font-size: var(--text-sm);
    color: var(--ink);
  }
  .int-item :global(.int-mark) {
    color: var(--ink-muted);
    transition: color var(--duration) var(--ease);
  }
  .int-item:hover :global(.int-mark) {
    color: var(--brand, var(--ink));
  }
</style>
