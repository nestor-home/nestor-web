---
/**
 * The services Nestor connects to, grouped by what they bring to a household (lib/integrations.ts):
 * marks in ink, each named beside it, in the brand's own colour on hover. What is not shipped yet
 * carries a "planned" badge, part of the item's text, on every page. `detailed` (the developers'
 * page) adds how each group is reached.
 */
import Brand from "@/components/Brand.astro";
import type { Translator } from "@/i18n";
import { BRANDS, type Brand as BrandInfo } from "@/lib/brands";
import { INTEGRATIONS } from "@/lib/integrations";

interface Props {
  t: Translator;
  /** the developers' page: how each group is reached */
  detailed?: boolean;
}
const { t, detailed = false } = Astro.props;
---

<div class="integrations">
  {
    INTEGRATIONS.map((g, gi) => (
      <div class="int-group" data-reveal style={`--i:${gi}`}>
        <p class="label-mono">{t(`int-group-${g.group}`)}</p>
        <ul class="mt-3 flex flex-col">
          {g.items.map(({ brand, status }) => {
            const { name, hex } = BRANDS[brand] as BrandInfo;
            return (
              <li class="int-item" style={hex ? `--brand:${hex}` : undefined}>
                <Brand brand={brand} class="int-mark size-[1.15rem]" decorative />
                <span class="min-w-0 truncate">{name}</span>
                {status === "planned" && (
                  <span class="int-planned ml-auto">
                    <span class="sr-only">, </span>
                    {t("int-planned")}
                  </span>
                )}
              </li>
            );
          })}
        </ul>
        {detailed && g.group === "home" && <p class="mt-2 font-mono text-[0.66rem] text-ink-muted">{t("int-via-ha")}</p>}
        {detailed && g.group === "work" && <p class="mt-2 font-mono text-[0.66rem] text-ink-muted">{t("int-any-mcp")}</p>}
      </div>
    ))
  }
</div>

<style>
  .integrations {
    display: grid;
    gap: 2rem 1.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 768px) {
    .integrations {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .integrations {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .int-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.4rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.9rem;
    color: var(--ink);
  }
  .int-planned {
    flex-shrink: 0;
    padding: 0 0.35rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font-size: 0.75rem;
    line-height: 1.1rem;
    color: var(--ink-muted);
  }
  .int-item :global(.int-mark) {
    color: var(--ink-muted);
    transition:
      color var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }
  .int-item:hover :global(.int-mark) {
    color: var(--brand, var(--ink));
    transform: scale(1.12);
  }
</style>
