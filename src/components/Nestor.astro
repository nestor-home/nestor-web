---
/**
 * The character on a page of the site: the shared drawing (src/character, a copy of the admin's
 * canonical module) with a starting state, a gaze, and an optional sequence played once in view
 * (`script="listening@0,speaking@900"`, run by the site script).
 */
import "@/character/nestor.css";
import { type NestorState, renderNestor } from "@/character/render";

export type { NestorState };
export type Look = "center" | "left" | "right" | "up" | "down";

interface Props {
  state?: NestorState;
  look?: Look;
  size?: number;
  label?: string | undefined;
  class?: string | undefined;
  script?: string | undefined;
  id?: string | undefined;
  ground?: boolean;
}
const {
  state = "idle",
  look = "center",
  size = 120,
  label,
  class: className,
  script,
  id,
  ground = false,
} = Astro.props;
const LOOK: Record<Look, [number, number, number]> = {
  center: [0, 0, 0],
  left: [-4, 0.5, -0.5],
  right: [4, 0.5, 0.5],
  up: [2, -4, 0.2],
  down: [0, 3.5, 0],
};
const [gx, gy, turn] = LOOK[look];
const attributes: Record<string, string> = { style: `--nestor-gx:${gx};--nestor-gy:${gy};--nestor-turn:${turn}` };
if (script) {
  attributes["data-script"] = script;
  attributes["data-inview-once"] = "";
}
const markup = renderNestor({
  state,
  size,
  ground,
  attributes,
  ...(label ? { label } : {}),
  ...(className ? { className } : {}),
  ...(id ? { id } : {}),
});
---

<Fragment set:html={markup} />
