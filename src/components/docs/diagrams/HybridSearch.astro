---
/**
 * Hybrid search on one example: the question's words and its meaning each rank the memories, and
 * reciprocal rank fusion puts first the one both lists hold.
 */
import { type Locale, translator } from "@/i18n";
import Figure from "./Figure.astro";

interface Props {
  locale: Locale;
  n: number;
}
const { locale, n } = Astro.props;
const t = translator(locale);
const lanes = [
  { id: "words", found: ["choir", "vegetarian"] },
  { id: "meaning", found: ["vegetarian", "coriander"] },
] as const;
const fused = ["vegetarian", "choir", "coriander"] as const;
---

<Figure t={t} n={n} caption="dg-search-caption">
  <div class="search">
    <div class="dg-node is-core search-question">
      <span class="dg-note">{t("dg-search-question-label")}</span>
      <span class="dg-title">{t("dg-search-question")}</span>
    </div>

    <span class="dg-arrow is-flow is-hot" aria-hidden="true"></span>

    <div class="search-lanes">
      {
        lanes.map((lane) => (
          <div class="dg-region">
            <span class="dg-label">{t(`dg-search-${lane.id}`)}</span>
            <ol class="search-list">
              {lane.found.map((memory, i) => (
                <li class:list={["search-item", memory === "vegetarian" && "is-both"]}>
                  <span class="search-rank">{i + 1}</span>
                  <span>{t(`dg-search-memory-${memory}`)}</span>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>

    <span class="dg-arrow is-flow is-hot" aria-hidden="true"></span>

    <div class="dg-region search-fused">
      <span class="dg-label">{t("dg-search-fused")}</span>
      <ol class="search-list">
        {
          fused.map((memory, i) => (
            <li class:list={["search-item", memory === "vegetarian" && "is-both"]}>
              <span class="search-rank">{i + 1}</span>
              <span>{t(`dg-search-memory-${memory}`)}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</Figure>

<style>
  .search {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.6rem;
  }
  .search > .dg-arrow {
    justify-self: center;
  }
  .search-question .dg-title {
    margin-top: 0.15rem;
    font-family: var(--font-display);
    font-variation-settings: var(--display-variation);
    font-size: var(--text-base);
    font-weight: 500;
  }
  .search-lanes {
    display: grid;
    gap: 1rem 0.75rem;
  }
  @container (min-width: 28rem) {
    .search-lanes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  :global(.doc-prose) .search-list {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(.doc-prose) .search-item {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.4rem;
    margin: 0;
    padding: 0.35rem 0.5rem;
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper);
    font-size: var(--text-sm);
    line-height: 1.35;
    color: var(--ink);
  }
  :global(.doc-prose) .search-item.is-both {
    border-color: var(--ember);
  }
  .search-rank {
    font-family: var(--font-data);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }
  .is-both .search-rank {
    color: var(--ember);
  }
</style>
