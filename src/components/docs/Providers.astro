---
/**
 * The documentation's provider picker: a mosaic of marks (a tab list), one provider's setup below.
 * Available providers' setups are the page's own content, passed as `<ProviderSetup>` children;
 * planned ones get the shared badge and a one-line note. Without JavaScript the default provider
 * (the first, the one `nestor init` writes) shows; with it, `#<kind>-<brand>`, the tile's id, opens
 * another (the shared tabs in scripts/site.ts, with `data-tabs-hash`; a grid, so every arrow moves).
 */
import Brand from "@/components/Brand.astro";
import Planned from "@/components/Planned.astro";
import { type Locale, translator } from "@/i18n";
import { BRANDS, type Brand as BrandInfo } from "@/lib/brands";
import { choiceId } from "@/lib/docs";
import { PROVIDERS, type ProviderKind } from "@/lib/providers";
import ChoicePanel from "./ChoicePanel.astro";

interface Props {
  kind: ProviderKind;
  locale: Locale;
}
const { kind, locale } = Astro.props;
const t = translator(locale);
const providers = PROVIDERS[kind];
---

<div class="providers" data-providers={kind}>
  <div role="tablist" aria-label={t(`providers-${kind}`)} class="providers-mosaic" data-tabs-grid data-tabs-hash>
    {
      providers.map(({ brand, status, local, label }, i) => {
        const b = BRANDS[brand] as BrandInfo;
        const name = label ? t(label) : b.name;
        const id = choiceId(kind, brand);
        return (
          <button
            type="button"
            role="tab"
            id={id}
            aria-controls={`${id}-panel`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            class="provider"
            style={b.hex ? `--brand:${b.hex}` : undefined}
          >
            <Brand brand={brand} class="choice-mark size-6" decorative />
            <span class="provider-name">{name}</span>
            {local && (
              <span class="provider-caption">
                <span class="sr-only">, </span>
                {t("providers-local")}
              </span>
            )}
            {status === "planned" && <Planned t={t} />}
          </button>
        );
      })
    }
  </div>
  <slot />
  {
    providers
      .filter((p) => p.status === "planned")
      .map(({ brand }) => (
        <ChoicePanel id={choiceId(kind, brand)} shown={false}>
          <p>{t("providers-planned-note", { name: (BRANDS[brand] as BrandInfo).name })}</p>
        </ChoicePanel>
      ))
  }
</div>

<style>
  .providers {
    margin-top: 1.5rem;
  }
  .providers-mosaic {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
    gap: 0.5rem;
  }
  .provider {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0.35rem;
    padding: 0.85rem 0.4rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    font-size: var(--text-sm);
    line-height: 1.2;
    text-align: center;
    cursor: pointer;
    transition: border-color var(--duration) var(--ease);
  }
  .provider:hover {
    border-color: var(--rule-strong);
  }
  .provider[aria-selected="true"] {
    border-color: var(--ink);
    background: var(--paper-raised);
  }
  .provider-name {
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .provider-caption {
    font-family: var(--font-data);
    font-size: var(--text-2xs);
    color: var(--ink-muted);
  }
</style>
