---
/**
 * A screen of the admin, as the reader sees it: in their language and their theme (both pictures are in the page,
 * the theme shows one). Captured from the admin on its fictional household by `scripts/capture-admin.mjs`, into
 * `public/docs/admin/<name>-<theme>-<locale>.webp`; `alt` says what the screen shows.
 */
import type { Locale } from "@/i18n";

interface Props {
  name: string;
  locale: Locale;
  alt: string;
  /** a short line under the picture */
  caption?: string;
}
const { name, locale, alt, caption } = Astro.props;
const src = (theme: "light" | "dark") => `/docs/admin/${name}-${theme}-${locale}.webp`;
---

<figure class="admin-shot">
  <img class="only-light" src={src("light")} alt={alt} width="1600" height="1000" loading="lazy" decoding="async" />
  <img class="only-dark" src={src("dark")} alt={alt} width="1600" height="1000" loading="lazy" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .admin-shot {
    overflow: hidden;
    border-radius: 0.9rem;
    box-shadow: var(--float);
  }
  .admin-shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .admin-shot figcaption {
    padding: 0.55rem 0.9rem;
    border-top: 1px solid var(--rule);
    background: var(--paper-raised);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
</style>
