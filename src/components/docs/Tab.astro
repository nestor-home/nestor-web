---
/**
 * One choice's content in a page's tabs (Tabs.astro). Only the set's first choice shows before a choice.
 */
import { TAB_SETS, type TabSet, tabId } from "@/lib/docs";

interface Props {
  set: TabSet;
  choice: string;
}
const { set, choice } = Astro.props;
const choices: readonly string[] = TAB_SETS[set];
if (!choices.includes(choice)) throw new Error(`[docs] no choice "${choice}" in the tabs "${set}"`);
const id = tabId(set, choice);
---

<div role="tabpanel" id={`${id}-panel`} aria-labelledby={id} tabindex="0" class="doc-tab-panel" hidden={choices[0] !== choice}>
  <slot />
</div>
