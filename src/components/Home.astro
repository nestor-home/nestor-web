---
import Architecture from "@/components/sections/Architecture.astro";
import Connectors from "@/components/sections/Connectors.astro";
import Control from "@/components/sections/Control.astro";
import Fast from "@/components/sections/Fast.astro";
import Hero from "@/components/sections/Hero.astro";
import HomeAssistant from "@/components/sections/HomeAssistant.astro";
import Journal from "@/components/sections/Journal.astro";
import Quickstart from "@/components/sections/Quickstart.astro";
import Richie from "@/components/sections/Richie.astro";
import Roadmap from "@/components/sections/Roadmap.astro";
import Satellites from "@/components/sections/Satellites.astro";
import Story from "@/components/sections/Story.astro";
import Thesis from "@/components/sections/Thesis.astro";
import { type Locale, translator } from "@/i18n";
import Base from "@/layouts/Base.astro";

interface Props {
  locale: Locale;
}
const t = translator(Astro.props.locale);
---

<Base locale={t.locale}>
  <Hero t={t} />
  <Thesis t={t} />
  <Story t={t} />
  <Architecture t={t} />
  <Fast t={t} />
  <HomeAssistant t={t} />
  <Connectors t={t} />
  <Satellites t={t} />
  <Journal t={t} />
  <Control t={t} />
  <Richie t={t} />
  <Quickstart t={t} />
  <Roadmap t={t} />
</Base>
