---
import Bodies from "@/components/sections/Bodies.astro";
import Cta from "@/components/sections/Cta.astro";
import Day from "@/components/sections/Day.astro";
import Hero from "@/components/sections/Hero.astro";
import Principles from "@/components/sections/Principles.astro";
import Why from "@/components/sections/Why.astro";
import TieRule from "@/components/TieRule.astro";
import { href, type Locale, pageMeta, translator } from "@/i18n";
import Base from "@/layouts/Base.astro";

interface Props {
  locale: Locale;
}
const t = translator(Astro.props.locale);
const nav = [
  { href: "#day", label: t("nav-day"), section: "day" },
  { href: "#principles", label: t("nav-principles"), section: "principles" },
  { href: href(t.locale, "developers"), label: t("nav-developers") },
];
---

<Base locale={t.locale} {...pageMeta(t, "home")} nav={nav}>
  <Hero t={t} />
  <Day t={t} />
  <TieRule />
  <Why t={t} />
  <Principles t={t} />
  <Bodies t={t} />
  <Cta t={t} />
</Base>
