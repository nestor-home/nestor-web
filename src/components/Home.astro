---
import Cta from "@/components/sections/Cta.astro";
import Hero from "@/components/sections/Hero.astro";
import Story from "@/components/sections/Story.astro";
import Works from "@/components/sections/Works.astro";
import { type Locale, pageMeta, translator } from "@/i18n";
import Base from "@/layouts/Base.astro";

interface Props {
  locale: Locale;
}
const t = translator(Astro.props.locale);
---

<Base locale={t.locale} {...pageMeta(t, "home")}>
  <Hero t={t} />
  <Story t={t} />
  <Works t={t} />
  <Cta t={t} />
</Base>
