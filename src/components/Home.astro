---
import Abilities from "@/components/sections/Abilities.astro";
import Bodies from "@/components/sections/Bodies.astro";
import Cta from "@/components/sections/Cta.astro";
import Hero from "@/components/sections/Hero.astro";
import Loop from "@/components/sections/Loop.astro";
import Trust from "@/components/sections/Trust.astro";
import TieRule from "@/components/TieRule.astro";
import { type Locale, pageMeta, translator } from "@/i18n";
import Base from "@/layouts/Base.astro";

interface Props {
  locale: Locale;
}
const t = translator(Astro.props.locale);
---

<Base locale={t.locale} {...pageMeta(t, "home")}>
  <Hero t={t} />
  <Loop t={t} />
  <TieRule />
  <Bodies t={t} />
  <Abilities t={t} />
  <Trust t={t} />
  <Cta t={t} />
</Base>
