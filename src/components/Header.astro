---
import { Moon, Sun } from "lucide-react";
import Brand from "@/components/Brand.astro";
import Wordmark from "@/components/Wordmark.astro";
import { href, type Page, type Translator } from "@/i18n";
import { REPOS } from "@/lib/site";

export interface NavItem {
  href: string;
  label: string;
  /** the id of the section on this page, for the "being read" highlight */
  section?: string;
}

interface Props {
  t: Translator;
  page: Page;
  nav: NavItem[];
}
const { t, page, nav } = Astro.props;
const other = t.locale === "en" ? "fr" : "en";
---

<header id="top" class="site-header sticky top-0 z-40 border-b border-transparent" data-header>
  <div class="wrap flex h-14 items-center justify-between gap-4">
    <a href={href(t.locale, "home")} class="text-[1.45rem]" aria-label={t("nav-home")}>
      <Wordmark />
    </a>
    <nav aria-label={t("nav-label")} class="hidden lg:block">
      <ul class="flex items-center gap-1 text-[0.9rem] text-ink-muted">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                data-nav={item.section}
                class="nav-link rounded-sm px-2.5 py-1.5 transition-colors hover:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="flex items-center gap-1.5">
      <a
        href={href(other, page)}
        hreflang={other}
        lang={other}
        class="grid h-9 place-items-center rounded-sm px-2 font-mono text-[0.75rem] text-ink-muted hover:text-ink"
        aria-label={t("lang-other-label")}>{t("lang-other")}</a
      >
      <button
        type="button"
        data-theme-toggle
        class="grid size-9 place-items-center rounded-sm text-ink-muted hover:text-ink"
        aria-label={t("theme-toggle")}
      >
        <Sun className="theme-icon-light size-4" strokeWidth={1.6} aria-hidden="true" />
        <Moon className="theme-icon-dark size-4" strokeWidth={1.6} aria-hidden="true" />
      </button>
      <a href={REPOS.nestor} class="btn btn-ink ml-1 h-9 px-3 text-[0.85rem]">
        <Brand brand="github" class="size-4" decorative />
        <span class="hidden sm:inline">{t("nav-github")}</span>
        <span class="sr-only sm:hidden">{t("nav-github")}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: saturate(1.2) blur(10px);
    transition: border-color var(--duration) var(--ease);
  }
  .site-header[data-scrolled] {
    border-bottom-color: var(--rule);
  }
  .nav-link[data-active] {
    color: var(--ink);
    background: var(--paper-sunken);
  }
  :global(.theme-icon-dark) {
    display: none;
  }
  :global(:root[data-theme="dark"] .theme-icon-dark) {
    display: block;
  }
  :global(:root[data-theme="dark"] .theme-icon-light) {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"]) .theme-icon-dark) {
      display: block;
    }
    :global(:root:not([data-theme="light"]) .theme-icon-light) {
      display: none;
    }
  }
</style>
