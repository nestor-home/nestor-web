---
/**
 * The one global navigation, identical on every page: the logo (home), the site's pages, then the
 * utilities (language, theme, GitHub) and one call to action. On small screens the pages and the
 * utilities move into a sheet (a modal <dialog>: focus kept inside, Escape closes, the page below
 * neither scrolls nor takes focus). In-page sections have their own bar (SubNav.astro).
 */
import { ArrowRight, Menu, Moon, Sun, X } from "lucide-react";
import Brand from "@/components/Brand.astro";
import Wordmark from "@/components/Wordmark.astro";
import { href, type Locale, type Page, type Translator } from "@/i18n";
import { REPOS } from "@/lib/site";

interface Props {
  t: Translator;
  /** this page's address in each language */
  alternates: Record<Locale, string>;
  /** the page being read, marked in the navigation */
  current?: Page | undefined;
}
const { t, alternates, current } = Astro.props;
const other = t.locale === "en" ? "fr" : "en";
const pages: { page: Page; label: string }[] = [
  { page: "home", label: t("nav-product") },
  { page: "developers", label: t("nav-developers") },
  { page: "docs", label: t("nav-docs") },
];
---

<header id="top" class="site-header sticky top-0 z-(--z-header) border-b border-transparent" data-header>
  <div class="wrap flex h-(--header-h) items-center gap-6">
    <a href={href(t.locale, "home")} class="text-wordmark" aria-label={t("nav-home")}>
      <Wordmark />
    </a>
    <nav aria-label={t("nav-label")} class="hidden md:block">
      <ul class="flex items-center gap-1 text-sm text-ink-muted">
        {
          pages.map(({ page, label }) => (
            <li>
              <a
                href={href(t.locale, page)}
                aria-current={current === page ? "page" : undefined}
                class="nav-link rounded-sm px-2.5 py-1.5 transition-colors hover:text-ink"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="ml-auto flex items-center gap-1">
      <a
        href={alternates[other]}
        hreflang={other}
        lang={other}
        class="hidden h-9 place-items-center rounded-sm px-2 font-mono text-xs text-ink-muted hover:text-ink md:grid"
        aria-label={t("lang-other-label")}>{t("lang-other")}</a
      >
      <button
        type="button"
        data-theme-toggle
        class="hidden size-9 place-items-center rounded-sm text-ink-muted hover:text-ink md:grid"
        aria-label={t("theme-toggle")}
      >
        <Sun className="theme-icon-light size-4" strokeWidth={1.6} aria-hidden="true" />
        <Moon className="theme-icon-dark size-4" strokeWidth={1.6} aria-hidden="true" />
      </button>
      <a href={REPOS.nestor} class="hidden size-9 place-items-center rounded-sm text-ink-muted hover:text-ink md:grid" aria-label={t("nav-github")}>
        <Brand brand="github" class="size-4" decorative />
      </a>
      <a href={href(t.locale, "docs")} class="btn btn-ink ml-2 h-9 px-3">{t("nav-cta")}</a>
      <button type="button" class="grid size-9 place-items-center rounded-sm text-ink-muted hover:text-ink md:hidden" aria-haspopup="dialog" aria-controls="menu-sheet" data-menu-open>
        <Menu className="size-5" strokeWidth={1.6} aria-hidden="true" />
        <span class="sr-only">{t("nav-menu")}</span>
      </button>
    </div>
  </div>

  <dialog id="menu-sheet" class="sheet" aria-label={t("nav-menu")} data-menu>
    <div class="flex h-(--header-h) items-center justify-between border-b border-rule px-4">
      <span class="text-wordmark"><Wordmark /></span>
      <button type="button" class="grid size-9 place-items-center rounded-sm text-ink-muted hover:text-ink" data-menu-close>
        <X className="size-5" strokeWidth={1.6} aria-hidden="true" />
        <span class="sr-only">{t("nav-close")}</span>
      </button>
    </div>
    <nav aria-label={t("nav-label")} class="px-4 py-2">
      <ul class="flex flex-col">
        {
          pages.map(({ page, label }) => (
            <li>
              <a
                href={href(t.locale, page)}
                aria-current={current === page ? "page" : undefined}
                class="sheet-link flex items-center justify-between border-b border-rule py-3 text-lg text-ink"
              >
                {label}
                {current === page && <span class="size-1.5 rounded-full bg-ember" aria-hidden="true" />}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mt-auto flex flex-col gap-3 border-t border-rule p-4">
      <a href={href(t.locale, "docs")} class="btn btn-ink justify-center">
        {t("nav-cta")}
        <ArrowRight className="size-4" strokeWidth={1.6} aria-hidden="true" />
      </a>
      <div class="flex items-center justify-between gap-2">
        <a href={alternates[other]} hreflang={other} lang={other} class="btn btn-line flex-1 justify-center">{t("lang-other-name")}</a>
        <button type="button" data-theme-toggle class="btn btn-line flex-1 justify-center" aria-label={t("theme-toggle")}>
          <Sun className="theme-icon-light size-4" strokeWidth={1.6} aria-hidden="true" />
          <Moon className="theme-icon-dark size-4" strokeWidth={1.6} aria-hidden="true" />
        </button>
        <a href={REPOS.nestor} class="btn btn-line flex-1 justify-center" aria-label={t("nav-github")}>
          <Brand brand="github" class="size-4" decorative />
        </a>
      </div>
    </div>
  </dialog>
</header>

<style>
  .site-header {
    background: var(--paper);
    transition: border-color var(--duration) var(--ease);
  }
  .site-header[data-scrolled] {
    border-bottom-color: var(--rule);
  }
  .nav-link[aria-current="page"] {
    color: var(--ink);
    background: var(--paper-sunken);
  }
  /* the sheet: from the right, over a dimmed page */
  .sheet {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(22rem, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-left: 1px solid var(--rule);
    background: var(--paper);
    color: var(--ink);
  }
  .sheet[open] {
    display: flex;
    flex-direction: column;
    animation: sheet-in 280ms var(--ease-out);
  }
  .sheet::backdrop {
    background: color-mix(in oklab, var(--ink) 30%, transparent);
  }
  .sheet-link[aria-current="page"] {
    font-weight: 500;
  }
  :global(html:has(.sheet[open])) {
    overflow: hidden;
  }
  @keyframes sheet-in {
    from {
      transform: translateX(100%);
    }
  }
  :global(.theme-icon-dark) {
    display: none;
  }
  :global(:root[data-theme="dark"] .theme-icon-dark) {
    display: block;
  }
  :global(:root[data-theme="dark"] .theme-icon-light) {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"]) .theme-icon-dark) {
      display: block;
    }
    :global(:root:not([data-theme="light"]) .theme-icon-light) {
      display: none;
    }
  }
</style>
