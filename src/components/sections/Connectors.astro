---
import { KeyRound, Mail } from "lucide-react";
import Brand from "@/components/Brand.astro";
import Shot from "@/components/Shot.astro";
import type { Translator } from "@/i18n";
import { BRANDS, type BrandKey } from "@/lib/brands";

interface Props {
  t: Translator;
}
const { t } = Astro.props;

const catalogue: { brand?: BrandKey; label: string; note?: string; later?: boolean }[] = [
  { brand: "gmail", label: "con-catalogue-gmail" },
  { label: "con-catalogue-imap" },
  { brand: "mcp", label: "con-catalogue-mcp" },
  { brand: "linear", label: "", note: "con-catalogue-via-mcp" },
  { brand: "notion", label: "", note: "con-catalogue-via-mcp" },
  { brand: "github", label: "", note: "con-catalogue-via-mcp" },
  { brand: "home-assistant", label: "", note: "con-catalogue-via-mcp" },
  { brand: "google-calendar", label: "con-catalogue-calendar", later: true },
];
const tools = [
  { text: "con-tool-search", risk: "con-risk-read", on: true },
  { text: "con-tool-read", risk: "con-risk-read", on: true },
  { text: "con-tool-draft", risk: "con-risk-read", on: true },
  { text: "con-tool-send", risk: "con-risk-write", on: false },
];
---

<section id="connectors" class="section border-t border-rule" aria-labelledby="con-title">
  <div class="wrap">
    <div class="max-w-3xl">
      <h2 id="con-title" data-reveal class="display-2 text-ink">{t("con-title")}</h2>
      <p data-reveal class="lede mt-6">{t("con-lede")}</p>
    </div>

    <ol class="mt-16 grid gap-px border border-rule bg-rule lg:grid-cols-3">
      <!-- 1. choose -->
      <li data-reveal style="--i:0" class="flex flex-col bg-paper p-6">
        <p class="font-mono text-[0.75rem] text-ember">1</p>
        <h3 class="display-3 mt-2 text-ink">{t("con-1")}</h3>
        <p class="prose-copy mt-3">{t("con-1-text")}</p>
        <ul class="mt-6 grid grid-cols-2 gap-2">
          {
            catalogue.map((c) => (
              <li
                class:list={[
                  "flex min-h-11 items-center gap-2 border border-rule bg-paper-raised px-2.5 py-2 text-[0.8rem]",
                  c.later ? "text-ink-muted" : "text-ink",
                ]}
              >
                {c.brand ? <Brand brand={c.brand} class="size-4" decorative /> : <Mail className="size-4" strokeWidth={1.6} aria-hidden="true" />}
                <span class="min-w-0 truncate">{c.label ? t(c.label) : c.brand ? BRANDS[c.brand].name : ""}</span>
                {c.note && <span class="ml-auto font-mono text-[0.62rem] whitespace-nowrap text-ink-muted">{t(c.note)}</span>}
                {c.later && <span class="ml-auto font-mono text-[0.62rem] whitespace-nowrap">{t("con-catalogue-soon")}</span>}
              </li>
            ))
          }
        </ul>
      </li>
      <!-- 2. consent -->
      <li data-reveal style="--i:1" class="flex flex-col bg-paper p-6">
        <p class="font-mono text-[0.75rem] text-ember">2</p>
        <h3 class="display-3 mt-2 text-ink">{t("con-2")}</h3>
        <p class="prose-copy mt-3">{t("con-2-text")}</p>
        <div class="consent corner-marks mt-6 border border-rule bg-paper-raised p-4">
          <p class="flex items-center gap-2 text-[0.85rem] text-ink">
            <Brand brand="gmail" class="size-4" decorative />
            {t("con-consent-app")}
          </p>
          <p class="mt-1 font-mono text-[0.7rem] text-ink-muted">{t("con-consent-account")}</p>
          <p class="mt-4 border-t border-rule pt-3 text-[0.85rem] text-ink-muted">{t("con-consent-scope")}</p>
          <p class="mt-3 flex items-center gap-2 font-mono text-[0.68rem] text-sage">
            <KeyRound className="size-3.5" strokeWidth={1.6} aria-hidden="true" />
            {t("con-consent-pkce")}
          </p>
          <p class="mt-4 flex justify-end">
            <span class="inline-flex h-8 items-center rounded-sm bg-ink px-3 text-[0.8rem] text-paper">{t("con-consent-allow")}</span>
          </p>
        </div>
      </li>
      <!-- 3. allow -->
      <li data-reveal style="--i:2" class="flex flex-col bg-paper p-6">
        <p class="font-mono text-[0.75rem] text-ember">3</p>
        <h3 class="display-3 mt-2 text-ink">{t("con-3")}</h3>
        <p class="prose-copy mt-3">{t("con-3-text")}</p>
        <ul class="mt-6 border-t border-rule">
          {
            tools.map((tool) => (
              <li class="flex items-start justify-between gap-3 border-b border-rule py-3">
                <span class="min-w-0">
                  <span class="block text-[0.85rem] leading-snug text-ink">{t(tool.text)}</span>
                  <span class:list={["font-mono text-[0.66rem]", tool.on ? "text-ink-muted" : "text-amber"]}>{t(tool.risk)}</span>
                </span>
                <span class="switch" data-on={tool.on ? "" : undefined} role="img" aria-label={t(tool.on ? "con-tool-on" : "con-tool-off")} />
              </li>
            ))
          }
        </ul>
      </li>
    </ol>

    <div class="mt-16 grid gap-12 lg:grid-cols-12">
      <div class="flex flex-col gap-10 lg:col-span-4">
        <div data-reveal>
          <h3 class="display-3 text-ink">{t("con-vault-title")}</h3>
          <p class="prose-copy mt-3">{t("con-vault-text")}</p>
        </div>
        <div data-reveal>
          <h3 class="display-3 text-ink">{t("con-person-title")}</h3>
          <p class="prose-copy mt-3">{t("con-person-text")}</p>
        </div>
      </div>
      <figure data-reveal class="lg:col-span-8">
        <div class="plate corner-marks">
          <div class="plate-inner">
            <Shot name="connection" locale={t.locale} alt={t("con-shot")} sizes="(min-width: 1024px) 800px, 100vw" />
          </div>
        </div>
        <figcaption class="mt-3 font-mono text-[0.72rem] text-ink-muted">{t("con-shot")}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .switch {
    position: relative;
    flex-shrink: 0;
    width: 2rem;
    height: 1.1rem;
    margin-top: 0.1rem;
    border-radius: 999px;
    background: var(--rule-strong);
  }
  .switch::after {
    content: "";
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 999px;
    background: var(--paper);
    transition: transform var(--duration) var(--ease);
  }
  .switch[data-on] {
    background: var(--ink);
  }
  .switch[data-on]::after {
    transform: translateX(0.9rem);
  }
</style>
