---
/**
 * How to start, as the last bento: the install (one tab per way, without a script), what it takes, then the
 * three ways to build on it, each tile a link to its page of the docs.
 */
import { ArrowRight, Cpu, Mic, Sparkles } from "lucide-react";
import Bento from "@/components/Bento.astro";
import Brand from "@/components/Brand.astro";
import CopyCommand from "@/components/CopyCommand.astro";
import Tile from "@/components/Tile.astro";
import { href, type Translator } from "@/i18n";
import { brandOf } from "@/lib/brands";
import { docHref } from "@/lib/docs";
import { MANIFEST_SNIPPET, QUICK_INSTALL, REPOS, SATELLITE_SNIPPET } from "@/lib/site";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
const needs = [
  { id: "machine", icon: Cpu },
  { id: "model", icon: Sparkles },
  { id: "voice", icon: Mic },
];
const languages = ["python", "typescript", "rust"] as const;
---

<section id="start" class="section border-t border-rule" aria-labelledby="cta-title">
  <div class="wrap">
    <div data-reveal class="flex flex-wrap items-end justify-between gap-6">
      <h2 id="cta-title" class="display-2 max-w-2xl text-ink">{t("cta-title")}</h2>
      <div class="flex flex-wrap gap-3">
        <a href={href(t.locale, "docs")} class="btn btn-ink">
          {t("cta-install")}
          <ArrowRight className="size-4" strokeWidth={1.6} aria-hidden="true" />
        </a>
        <a href={REPOS.nestor} class="btn btn-line">
          <Brand brand="github" class="size-4" decorative />
          {t("nav-github")}
        </a>
      </div>
    </div>

    <Bento class="mt-12">
      <Tile id="cta-run" title={t("cta-run-title")} text={t("cta-run-text")} span={7}>
        <!-- one tab per way, without a script: a radio, its label, then its commands -->
        <div class="install" style={`--ways: ${QUICK_INSTALL.length}`} role="group" aria-label={t("cta-install-label")}>
          {
            QUICK_INSTALL.map((way, i) => (
              <>
                <input type="radio" name="install" id={`install-${way.id}`} class="sr-only" checked={i === 0} />
                <label for={`install-${way.id}`} class="install-tab">
                  {way.label}
                </label>
                <CopyCommand t={t} command={way.command} class="install-way" />
              </>
            ))
          }
        </div>
      </Tile>
      <Tile id="cta-needs" title={t("cta-needs-title")} text={t("cta-needs-text")} span={5}>
        <ul class="needs">
          {
            needs.map(({ id, icon: Icon }) => (
              <li class="need">
                <span class="icon-tile is-ember" style="--tile: 2rem">
                  <Icon className="size-4" strokeWidth={1.7} aria-hidden="true" />
                </span>
                {t(`cta-need-${id}`)}
              </li>
            ))
          }
        </ul>
      </Tile>
      <Tile
        id="cta-satellite"
        title={t("cta-build-satellite")}
        text={t("cta-build-satellite-text")}
        span={4}
        href={docHref(t.locale, "satellites")}
      >
        <pre class="snippet" aria-hidden="true"><code>{SATELLITE_SNIPPET}</code></pre>
      </Tile>
      <Tile
        id="cta-sdks"
        title={t("cta-build-sdks")}
        text={t("cta-build-sdks-text")}
        span={4}
        href={docHref(t.locale, "sdks/python")}
      >
        <ul class="langs">
          {
            languages.map((brand) => (
              <li class="lang">
                <span class="icon-tile is-raised" style="--tile: 4rem">
                  <Brand brand={brand} class="size-7" decorative />
                </span>
                <span class="lang-name">{brandOf(brand).name}</span>
              </li>
            ))
          }
        </ul>
      </Tile>
      <Tile
        id="cta-protocol"
        title={t("cta-build-protocol")}
        text={t("cta-build-protocol-text")}
        span={4}
        href={docHref(t.locale, "satellites/protocol")}
      >
        <pre class="snippet" aria-hidden="true"><code>{MANIFEST_SNIPPET}</code></pre>
      </Tile>
    </Bento>
  </div>
</section>

<style>
  /* the install tabs: labels on the first row, the checked radio's commands under them */
  .install {
    display: grid;
    width: min(100%, 34rem);
    grid-template-columns: repeat(var(--ways, 2), max-content) 1fr;
    column-gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .install-tab {
    grid-row: 1;
    cursor: pointer;
    padding: 0.25rem 0.65rem;
    border-radius: 0.4rem;
    color: var(--ink-muted);
  }
  .install-tab:hover {
    color: var(--ink);
  }
  .install :global(.install-way) {
    grid-row: 2;
    grid-column: 1 / -1;
    margin-top: 0.5rem;
  }
  .install input:not(:checked) + .install-tab + :global(.install-way) {
    display: none;
  }
  .install input:checked + .install-tab {
    background: var(--paper-raised);
    color: var(--ink);
    box-shadow: var(--lift);
  }
  .install input:focus-visible + .install-tab {
    outline: 2px solid var(--ember);
    outline-offset: 2px;
  }

  .needs {
    display: grid;
    width: min(100%, 22rem);
    gap: 0.5rem;
  }
  .need {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.85rem;
    border-radius: 0.9rem;
    background: var(--paper-raised);
    box-shadow: var(--lift);
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .snippet {
    width: 100%;
    overflow: hidden;
    padding: 1rem 1.1rem;
    border-radius: 0.9rem;
    background: var(--device);
    color: var(--device-code);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    line-height: 1.6;
    white-space: pre;
  }

  .langs {
    display: flex;
    gap: 1rem;
  }
  .lang {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
  }
  .lang-name {
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }
</style>
