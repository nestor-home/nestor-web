---
import { ArrowRight } from "lucide-react";
import Brand from "@/components/Brand.astro";
import CopyCommand from "@/components/CopyCommand.astro";
import Dither from "@/components/Dither.astro";
import Nestor from "@/components/Nestor.astro";
import Tie from "@/components/Tie.astro";
import { href, type Translator } from "@/i18n";
import { INSTALL, REPOS } from "@/lib/site";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
---

<section id="start" class="section relative overflow-hidden border-t border-rule" aria-labelledby="cta-title" data-mood="idle" data-say={t("char-ready")}>
  <Dither shape="ramp-up" from={0} to={0.4} dot={3} class="absolute inset-x-0 bottom-0 h-40 text-ink/15" />
  <div class="wrap relative grid items-center gap-12 lg:grid-cols-12">
    <div class="lg:col-span-6">
      <h2 id="cta-title" data-reveal class="display-1 text-ink">{t("cta-title")}</h2>
      <p data-reveal class="lede mt-8">{t("cta-text")}</p>
      <div data-reveal class="mt-8 flex flex-wrap gap-3">
        <a href={href(t.locale, "docs")} class="btn btn-ink">
          {t("cta-install")}
          <ArrowRight className="size-4" strokeWidth={1.6} aria-hidden="true" />
        </a>
        <a href={href(t.locale, "developers")} class="btn btn-line">{t("cta-developers")}</a>
        <a href={REPOS.nestor} class="btn btn-line">
          <Brand brand="github" class="size-4" decorative />
          {t("nav-github")}
        </a>
      </div>
      <p data-reveal class="mt-6 flex items-center gap-2 font-mono text-[0.75rem] text-ink-muted">
        <Tie size={13} />
        {t("cta-early")}
      </p>
    </div>
    <div class="relative lg:col-span-6">
      <Nestor size={110} state="idle" look="down" script="idle@0,laughing@600,idle@1700" class="cta-nestor" />
      <div data-reveal class="corner-marks border border-rule-strong bg-paper-raised">
        <p class="border-b border-rule px-4 py-2.5 font-mono text-[0.7rem] text-ink-muted">{t("cta-terminal")}</p>
        <div class="flex flex-col gap-2 p-4">
          {INSTALL.map((command) => <CopyCommand t={t} command={command} />)}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-nestor {
    display: block;
    margin: 0 1.5rem -0.6rem auto;
  }
</style>
