---
import { ArrowRight } from "lucide-react";
import Brand from "@/components/Brand.astro";
import CopyCommand from "@/components/CopyCommand.astro";
import Tie from "@/components/Tie.astro";
import { href, type Translator } from "@/i18n";
import { docHref } from "@/lib/docs";
import { INSTALL, REPOS } from "@/lib/site";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
const needs = ["cta-need-machine", "cta-need-model", "cta-need-time"];
const build = [
  { id: "satellite", slug: "satellites" },
  { id: "sdks", slug: "sdks/python" },
  { id: "protocol", slug: "satellites/protocol" },
];
---

<section id="start" class="section border-t border-rule" aria-labelledby="cta-title">
  <div class="wrap grid items-start gap-x-12 gap-y-10 lg:grid-cols-12">
    <div class="lg:col-span-6">
      <h2 id="cta-title" data-reveal class="display-1 text-ink">{t("cta-title")}</h2>
      <ul data-reveal class="mt-8 grid gap-3">
        {
          needs.map((id) => (
            <li class="flex gap-3 text-ink">
              <Tie size={13} class="mt-1.5 shrink-0" />
              <span>{t(id)}</span>
            </li>
          ))
        }
      </ul>
      <div data-reveal class="mt-8 flex flex-wrap gap-3">
        <a href={href(t.locale, "docs")} class="btn btn-ink">
          {t("cta-install")}
          <ArrowRight className="size-4" strokeWidth={1.6} aria-hidden="true" />
        </a>
        <a href={REPOS.nestor} class="btn btn-line">
          <Brand brand="github" class="size-4" decorative />
          {t("nav-github")}
        </a>
      </div>
      <p data-reveal class="mt-6 text-sm text-ink-muted">{t("cta-early")}</p>
    </div>
    <div data-reveal class="cta-terminal lg:col-span-6">
      <p class="border-b border-rule px-4 py-2.5 text-sm text-ink-muted">{t("cta-terminal")}</p>
      <div class="p-4">
        <CopyCommand t={t} command={INSTALL.join("\n")} />
      </div>
    </div>
  </div>

  <div class="wrap mt-16 lg:mt-24">
    <h3 data-reveal class="display-3 text-ink">{t("cta-build-title")}</h3>
    <ul class="mt-6 grid gap-3 md:grid-cols-3">
      {
        build.map(({ id, slug }, i) => (
          <li data-reveal style={`--i:${i}`}>
            <a href={docHref(t.locale, slug)} class="cta-card">
              <span class="font-serif text-xl text-ink">{t(`cta-build-${id}`)}</span>
              <span class="mt-1.5 block text-ink-muted">{t(`cta-build-${id}-text`)}</span>
              <ArrowRight className="mt-4 size-4 text-ink-faint" strokeWidth={1.6} aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cta-terminal,
  .cta-card {
    border-radius: var(--radius-surface);
    background: var(--paper-raised);
    box-shadow: var(--lift);
  }
  .cta-terminal {
    overflow: hidden;
  }
  .cta-card {
    display: block;
    height: 100%;
    padding: 1.25rem;
    text-decoration: none;
    transition:
      box-shadow var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }
  .cta-card:hover {
    box-shadow: var(--lift-hover);
    transform: translateY(-1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .cta-card:hover {
      transform: none;
    }
  }
</style>
