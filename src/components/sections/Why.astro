---
/** "You always know why it spoke": the journal, from the use side, with the recording of the admin. */
import Clip from "@/components/Clip.astro";
import Nestor from "@/components/Nestor.astro";
import Shot from "@/components/Shot.astro";
import type { Translator } from "@/i18n";
import { clip } from "@/lib/media";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
const hasLive = clip("journal-live", t.locale).length > 0;
---

<section id="why" class="section border-t border-rule" aria-labelledby="jr-title">
  <div class="wrap">
    <div class="flex items-end justify-between gap-8">
      <div class="max-w-3xl">
        <h2 id="jr-title" data-reveal class="display-2 text-ink">{t("jr-title")}</h2>
        <p data-reveal class="lede mt-6">{t("jr-lede")}</p>
      </div>
      <Nestor size={88} state="thinking" class="hidden md:block" />
    </div>
    <figure data-reveal class="mt-12">
      <div class="plate corner-marks">
        <div class="plate-inner">
          {
            hasLive ? (
              <Clip name="journal-live" t={t} label={t("jr-clip")} />
            ) : (
              <Shot name="journal" locale={t.locale} alt={t("jr-clip")} />
            )
          }
        </div>
      </div>
      <figcaption class="mt-3 font-mono text-[0.72rem] text-ink-muted">{t("jr-clip")}</figcaption>
    </figure>
  </div>
</section>
