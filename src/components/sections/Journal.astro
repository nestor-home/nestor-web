---
import Clip from "@/components/Clip.astro";
import Shot from "@/components/Shot.astro";
import type { Translator } from "@/i18n";
import { clip } from "@/lib/media";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
const notes = ["jr-note-1", "jr-note-2", "jr-note-3"];
const hasLive = clip("journal-live", t.locale).length > 0;
const more = [
  { name: "command", label: "jr-more-command" },
  { name: "journal-filters", label: "jr-more-filters" },
].filter((m) => clip(m.name, t.locale).length > 0);
const mobile = clip("mobile", t.locale).length > 0;
---

<section id="journal" class="section border-t border-rule" aria-labelledby="jr-title">
  <div class="wrap">
    <div class="max-w-3xl">
      <h2 id="jr-title" data-reveal class="display-2 text-ink">{t("jr-title")}</h2>
      <p data-reveal class="lede mt-6">{t("jr-lede")}</p>
    </div>

    <figure data-reveal class="mt-14">
      <div class="plate corner-marks">
        <div class="plate-inner">
          {
            hasLive ? (
              <Clip name="journal-live" t={t} label={t("jr-clip")} />
            ) : (
              <Shot name="journal" locale={t.locale} alt={t("jr-clip")} />
            )
          }
        </div>
      </div>
      <figcaption class="mt-3 font-mono text-[0.72rem] text-ink-muted">{t("jr-clip")}</figcaption>
    </figure>
    <ol class="mt-8 grid gap-6 border-t border-rule pt-6 md:grid-cols-3">
      {
        notes.map((id, i) => (
          <li data-reveal style={`--i:${i}`} class="flex gap-3 text-[0.95rem] leading-relaxed text-ink-muted">
            <span class="font-mono text-[0.75rem] text-ember tabular">{i + 1}</span>
            <span>{t(id)}</span>
          </li>
        ))
      }
    </ol>

    {
      (more.length > 0 || mobile) && (
        <div class="mt-24">
          <h3 data-reveal class="display-3 text-ink">
            {t("jr-more-title")}
          </h3>
          <div class="mt-8 grid gap-8 md:grid-cols-12">
            <div class="flex flex-col gap-8 md:col-span-8">
              {more.map((m) => (
                <figure data-reveal>
                  <div class="plate">
                    <div class="plate-inner">
                      <Clip name={m.name} t={t} label={t(m.label)} />
                    </div>
                  </div>
                  <figcaption class="mt-3 font-mono text-[0.72rem] text-ink-muted">{t(m.label)}</figcaption>
                </figure>
              ))}
            </div>
            {mobile && (
              <figure data-reveal class="md:col-span-4">
                <div class="plate mx-auto max-w-[19rem] rounded-[22px] [&>.plate-inner]:rounded-[14px]">
                  <div class="plate-inner">
                    <Clip name="mobile" t={t} label={t("jr-more-mobile")} />
                  </div>
                </div>
                <figcaption class="mt-3 text-center font-mono text-[0.72rem] text-ink-muted">{t("jr-more-mobile")}</figcaption>
              </figure>
            )}
          </div>
        </div>
      )
    }
  </div>
</section>
