---
import Clip from "@/components/Clip.astro";
import Shot from "@/components/Shot.astro";
import type { Translator } from "@/i18n";
import { clip } from "@/lib/media";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
const filters = clip("journal-filters", t.locale).length > 0;
---

<section id="journal" class="section border-t border-rule" aria-labelledby="jr-dev-title" data-mood="thinking">
  <div class="wrap grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h2 id="jr-dev-title" data-reveal class="display-2 text-ink">{t("jr-dev-title")}</h2>
      <p data-reveal class="prose-copy mt-6">{t("jr-dev-text")}</p>
    </div>
    <figure data-reveal class="lg:col-span-8">
      <div class="plate corner-marks">
        <div class="plate-inner">
          {
            filters ? (
              <Clip name="journal-filters" t={t} label={t("jr-dev-clip")} />
            ) : (
              <Shot name="journal" locale={t.locale} alt={t("jr-dev-clip")} />
            )
          }
        </div>
      </div>
      <figcaption class="mt-3 font-mono text-[0.72rem] text-ink-muted">{t("jr-dev-clip")}</figcaption>
    </figure>
  </div>
</section>
