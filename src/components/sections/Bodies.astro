---
/** Same agent, any body: the house as a constellation the visitor builds, device by device. */
import Constellation from "@/components/Constellation.astro";
import type { Translator } from "@/i18n";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
---

<section id="bodies" class="section" aria-labelledby="bodies-title" data-mood="laughing" data-say={t("char-switch")}>
  <div class="wrap">
    <div class="max-w-3xl">
      <h2 id="bodies-title" data-reveal class="display-2 text-ink">{t("cst-title")}</h2>
      <p data-reveal class="lede mt-6">{t("cst-lede")}</p>
    </div>
    <div data-reveal class="mt-14">
      <Constellation t={t} mode="home" />
    </div>
  </div>
</section>
