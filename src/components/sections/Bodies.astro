---
/**
 * Same agent, any body: one conversation that moves from the kitchen speaker to a phone, a wall
 * tablet and a robot. A WAI-ARIA tab list (the site script); choosing a body shows it, its
 * character listens then answers, and what Nestor remembers stays the same beside it.
 * Without JavaScript the first body shows, and every body is reachable as a tab panel.
 */
import { Check } from "lucide-react";
import Brand from "@/components/Brand.astro";
import Device, { type DeviceKind } from "@/components/Device.astro";
import type { Translator } from "@/i18n";

interface Props {
  t: Translator;
}
const { t } = Astro.props;

const bodies: { id: string; kind: DeviceKind; size: number; screen: boolean }[] = [
  { id: "speaker", kind: "speaker", size: 120, screen: false },
  { id: "phone", kind: "phone", size: 104, screen: true },
  { id: "tablet", kind: "tablet", size: 150, screen: true },
  { id: "robot", kind: "robot", size: 110, screen: false },
];
const SCRIPT = "listening@0,thinking@900,speaking@1300,idle@4200";
---

<section id="bodies" class="section" aria-labelledby="bodies-title" data-mood="laughing" data-say={t("char-switch")}>
  <div class="wrap">
    <div class="max-w-3xl">
      <h2 id="bodies-title" data-reveal class="display-2 text-ink">{t("bodies-title")}</h2>
      <p data-reveal class="lede mt-6">{t("bodies-lede")}</p>
    </div>

    <div data-reveal class="bodies mt-14">
      <div class="bodies-tabs">
        <div role="tablist" aria-label={t("bodies-tabs")} aria-orientation="vertical" class="flex flex-col">
          {
            bodies.map((b, i) => (
              <button
                type="button"
                role="tab"
                id={`body-tab-${b.id}`}
                aria-controls={`body-${b.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                class="body-tab"
              >
                <span class="body-index font-mono tabular" aria-hidden="true">
                  {i + 1}
                </span>
                <span class="flex min-w-0 flex-col items-start">
                  <span class="body-name">{t(`bodies-${b.id}`)}</span>
                  <span class="font-mono text-[0.7rem] text-ink-muted">{t(`bodies-${b.id}-where`)}</span>
                </span>
              </button>
            ))
          }
        </div>
        <p class="mt-5 hidden font-mono text-[0.72rem] text-ink-muted lg:block">{t("bodies-hint")}</p>
      </div>

      <div class="body-stage corner-marks">
        {
          bodies.map((b, i) => (
            <div role="tabpanel" id={`body-${b.id}`} aria-labelledby={`body-tab-${b.id}`} hidden={i !== 0} tabindex="0" class="body-panel">
              <p class="body-ask bubble-ask">
                <span class="bubble-who">{t(`bodies-${b.id}-who`)}</span>
                {t(`bodies-${b.id}-ask`)}
              </p>
              <div class="body-device">
                {b.screen ? (
                  <Device kind={b.kind} size={b.kind === "phone" ? 58 : 80} script={SCRIPT}>
                    <div class="flex flex-col gap-2 px-1 pb-1">
                      {b.kind === "phone" && (
                        <p class="flex items-center gap-1.5 font-mono text-[0.62rem] text-ink-muted">
                          <Brand brand="telegram" class="size-3" decorative />
                          <Brand brand="whatsapp" class="size-3" decorative />
                          <Brand brand="discord" class="size-3" decorative />
                        </p>
                      )}
                      <p class="body-say bubble-say text-[0.82rem]">{t(`bodies-${b.id}-say`)}</p>
                    </div>
                  </Device>
                ) : (
                  <>
                    <Device kind={b.kind} size={b.size} look="right" script={SCRIPT} />
                    <p class="body-say bubble-say">{t(`bodies-${b.id}-say`)}</p>
                  </>
                )}
              </div>
            </div>
          ))
        }
      </div>

      <aside class="body-memory" aria-labelledby="bodies-knows">
        <p id="bodies-knows" class="label-mono">{t("bodies-knows")}</p>
        <div class="mt-3 border border-rule bg-paper p-3">
          <p class="font-serif text-[1.05rem] text-ink">{t("bodies-memory")}</p>
          <p class="mt-1 font-mono text-[0.66rem] text-ink-muted">{t("bodies-memory-source")}</p>
        </div>
        <div class="mt-3 border border-rule bg-paper p-3">
          <p class="font-mono text-[0.68rem] text-ink-muted">{t("bodies-list")}</p>
          <ul class="mt-2 flex flex-col gap-1.5">
            {
              [1, 2, 3, 4].map((k) => (
                <li class="flex items-center gap-2 text-[0.88rem] text-ink">
                  <span class="grid size-3.5 place-items-center border border-rule-strong" aria-hidden="true">
                    {k > 2 && <Check className="size-3 text-ink-muted" strokeWidth={2} />}
                  </span>
                  {t(`bodies-item-${k}`)}
                </li>
              ))
            }
          </ul>
        </div>
        <p class="mt-4 text-[0.88rem] leading-relaxed text-ink-muted">{t("bodies-channels")}</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .bodies {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 1024px) {
    .bodies {
      grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr);
      gap: 2.5rem;
      align-items: start;
    }
  }
  .body-tab {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: 100%;
    padding: 0.8rem 0.6rem;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    transition: background-color var(--duration) var(--ease);
  }
  .body-tab:first-child {
    border-top: 1px solid var(--rule);
  }
  .body-tab:hover {
    background: var(--paper-raised);
  }
  .body-index {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font-size: 0.7rem;
    color: var(--ink-muted);
    transition:
      background-color var(--duration) var(--ease),
      color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }
  .body-name {
    font-family: var(--font-display);
    font-variation-settings: var(--display-variation);
    font-size: 1.15rem;
    color: var(--ink-muted);
    transition: color var(--duration) var(--ease);
  }
  .body-tab[aria-selected="true"] .body-name {
    color: var(--ink);
  }
  .body-tab[aria-selected="true"] .body-index {
    background: var(--ember);
    border-color: var(--ember);
    color: var(--on-ember);
  }
  .body-stage {
    position: relative;
    min-height: 27rem;
    padding: 1.5rem 1.25rem;
    border: 1px solid var(--rule);
    background: var(--paper-raised);
  }
  .body-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    height: 100%;
  }
  .body-ask {
    align-self: flex-end;
  }
  .body-device {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: center;
    gap: 1.25rem;
  }
  .body-device > .body-say {
    margin-bottom: 4rem;
  }
  /* a body comes in: it rises, the person speaks, then Nestor answers (each time it is chosen) */
  :global(.js) .body-panel:not([hidden]) .body-device {
    animation: rise 600ms var(--ease-out) both;
  }
  :global(.js) .body-panel:not([hidden]) .body-ask {
    animation: rise 500ms var(--ease-out) 150ms both;
  }
  :global(.js) .body-panel:not([hidden]) .body-say {
    animation: rise 500ms var(--ease-out) 1300ms both;
  }
  .body-memory {
    padding-top: 0.25rem;
  }
  @media (max-width: 1023px) {
    .bodies-tabs [role="tablist"] {
      flex-direction: row;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .body-tab {
      flex: 0 0 auto;
      width: auto;
      border: 1px solid var(--rule);
      border-right: 0;
    }
    .body-tab:last-child {
      border-right: 1px solid var(--rule);
    }
    .body-tab .font-mono:not(.body-index) {
      display: none;
    }
    .body-stage {
      min-height: 24rem;
    }
  }
  @media (max-width: 639px) {
    .body-tab {
      padding: 0.6rem 0.7rem;
      gap: 0.5rem;
    }
    .body-name {
      font-size: 0.95rem;
    }
    .body-device > .body-say {
      margin-bottom: 0;
    }
  }
</style>
