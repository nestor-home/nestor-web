---
import type { Translator } from "@/i18n";
import { REPOS } from "@/lib/site";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
const groups = [
  { title: "rm-shipped", state: "shipped", items: Array.from({ length: 10 }, (_, i) => `rm-s-${i + 1}`) },
  { title: "rm-next", state: "next", items: ["rm-n-1", "rm-n-2"] },
  { title: "rm-later", state: "later", items: Array.from({ length: 6 }, (_, i) => `rm-l-${i + 1}`) },
];
---

<section class="section border-t border-rule" aria-labelledby="rm-title">
  <div class="wrap">
    <div class="max-w-3xl">
      <h2 id="rm-title" data-reveal class="display-2 text-ink">{t("rm-title")}</h2>
      <p data-reveal class="lede mt-6">{t("rm-lede")}</p>
    </div>
    <div class="mt-14 grid gap-12 md:grid-cols-3 md:gap-8">
      {
        groups.map((g, gi) => (
          <div data-reveal style={`--i:${gi}`}>
            <h3 class="flex items-center gap-2 border-b border-rule-strong pb-3">
              <span class="state" data-state={g.state} aria-hidden="true" />
              <span class="font-sans text-[1rem] font-medium tracking-normal text-ink">{t(g.title)}</span>
            </h3>
            <ul>
              {g.items.map((id) => (
                <li class="border-b border-rule py-3 text-[0.92rem] leading-snug text-ink-muted" set:html={t.html(id)} />
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p data-reveal class="mt-8">
      <a class="link font-mono text-[0.8rem]" href={REPOS.nestor}>{t("rm-source")} →</a>
    </p>
  </div>
</section>
