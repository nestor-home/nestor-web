---
import type { Translator } from "@/i18n";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
const MAX = 4; // seconds on the axis
const bars = [
  { label: "fast-direct", value: "fast-direct-value", seconds: 0.64, tone: "ember" },
  { label: "fast-harness", value: "fast-harness-value", seconds: 3.46, tone: "ink" },
];
const delegation = ["fast-delegate-1", "fast-delegate-2", "fast-delegate-3", "fast-delegate-4"];
const manners = ["fast-manners-1", "fast-manners-2"];
---

<section class="section border-t border-rule" aria-labelledby="fast-title">
  <div class="wrap">
    <div class="max-w-3xl">
      <h2 id="fast-title" data-reveal class="display-2 text-ink">{t("fast-title")}</h2>
      <p data-reveal class="lede mt-6">{t("fast-lede")}</p>
    </div>

    <div class="mt-16 grid gap-14 lg:grid-cols-12 lg:gap-10">
      <div data-reveal class="lg:col-span-5">
        <p class="first-sound font-serif text-ink tabular">{t("fast-first-sound-value")}</p>
        <p class="mt-3 text-[1.05rem] text-ink">{t("fast-first-sound")}</p>
        <p class="mt-4 max-w-sm font-mono text-[0.72rem] leading-relaxed text-ink-muted">{t("fast-first-sound-note")}</p>
      </div>

      <figure data-reveal class="lg:col-span-7" data-inview-once>
        <figcaption class="text-[1rem] text-ink">{t("fast-why")}</figcaption>
        <div class="chart mt-6">
          {
            bars.map((b, i) => (
              <div class="bar-row" style={`--i:${i}`}>
                <p class="flex items-baseline justify-between gap-4 text-[0.88rem] text-ink-muted">
                  <span>{t(b.label)}</span>
                  <span class:list={["font-mono text-[0.85rem] tabular", b.tone === "ember" ? "text-ember" : "text-ink"]}>
                    {t(b.value)}
                  </span>
                </p>
                <div class="track mt-2">
                  <div class:list={["bar", `bar-${b.tone}`]} style={`--w:${b.seconds / MAX}`} />
                </div>
              </div>
            ))
          }
          <div class="axis mt-3 flex justify-between font-mono text-[0.68rem] text-ink-faint tabular" aria-hidden="true">
            {Array.from({ length: MAX + 1 }, (_, s) => <span>{s}</span>)}
          </div>
        </div>
        <p class="mt-4 font-mono text-[0.72rem] text-ink-muted">{t("fast-why-note")}</p>
      </figure>
    </div>

    <div class="mt-20 grid gap-12 md:grid-cols-2 md:gap-10">
      <div>
        <h3 data-reveal class="display-3 text-ink">{t("fast-delegate-title")}</h3>
        <ol class="mt-6 border-t border-rule">
          {
            delegation.map((id, i) => (
              <li data-reveal style={`--i:${i}`} class="flex gap-4 border-b border-rule py-4 text-[0.98rem] leading-relaxed text-ink-muted">
                <span class="mt-0.5 font-mono text-[0.75rem] text-ink-faint tabular">{i + 1}</span>
                <span>{t(id)}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <h3 data-reveal class="display-3 text-ink">{t("fast-manners-title")}</h3>
        <ul class="mt-6 border-t border-rule">
          {
            manners.map((id, i) => (
              <li data-reveal style={`--i:${i}`} class="border-b border-rule py-4 text-[0.98rem] leading-relaxed text-ink-muted">
                {t(id)}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .first-sound {
    font-size: clamp(3.4rem, 7.5vw, 6.2rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    font-variation-settings:
      "SOFT" 60,
      "opsz" 144;
  }
  .chart .bar-row + .bar-row {
    margin-top: 1.5rem;
  }
  .track {
    position: relative;
    height: 0.9rem;
    background-image: repeating-linear-gradient(
      to right,
      var(--rule) 0,
      var(--rule) 1px,
      transparent 1px,
      transparent 25%
    );
    border-bottom: 1px solid var(--rule-strong);
  }
  .bar {
    height: 100%;
    width: calc(var(--w) * 100%);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 1.2s var(--ease-out);
    transition-delay: calc(var(--i, 0) * 180ms + 150ms);
  }
  .bar-row {
    --i: 0;
  }
  .bar-ember {
    background: var(--ember);
  }
  .bar-ink {
    background: var(--ink);
  }
  [data-inview] .bar,
  :global(.no-js) .bar {
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .bar {
      transform: none;
    }
  }
</style>
