---
import { ArrowDown, ArrowRight } from "lucide-react";
import Brand from "@/components/Brand.astro";
import CopyCommand from "@/components/CopyCommand.astro";
import Dither from "@/components/Dither.astro";
import Nestor from "@/components/Nestor.astro";
import { href, type Translator } from "@/i18n";
import { QUICK_INSTALL, REPOS } from "@/lib/site";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
const lines = ["hero-line-1", "hero-line-2", "hero-line-3"];
const facts = ["hero-fact-license", "hero-fact-python", "hero-fact-sdks"];
---

<section class="hero relative overflow-hidden" aria-labelledby="hero-title" data-dock-after>
  <div class="wrap grid items-center gap-10 pt-12 pb-20 sm:pt-16 lg:grid-cols-12 lg:gap-8 lg:pt-20 lg:pb-28">
    <div class="lg:col-span-7">
      <h1 id="hero-title" class="display-1 display-hero text-ink">
        {
          lines.map((id, i) => (
            <span class="hero-line block" style={`--i:${i}`}>
              {t(id)}
            </span>
          ))
        }
      </h1>
      <div class="hero-after mt-8 md:mt-10">
        <p class="lede">{t("hero-lede")}</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={href(t.locale, "docs")} class="btn btn-ink">
            {t("hero-start")}
            <ArrowRight className="size-4" strokeWidth={1.6} aria-hidden="true" />
          </a>
          <a href={REPOS.nestor} class="btn btn-line">
            <Brand brand="github" class="size-4" decorative />
            {t("nav-github")}
          </a>
          <a href="#story" class="link inline-flex items-center gap-1.5 px-2 font-mono text-xs" data-dock-follow={t("char-follow")}>
            {t("hero-story")}
            <ArrowDown className="size-3.5" strokeWidth={1.6} aria-hidden="true" />
          </a>
        </div>

        <!-- the quick install: one tab per way, without a script (a radio, its label, then its commands) -->
        <div class="hero-install mt-8 max-w-xl font-mono text-2xs" style={`--ways: ${QUICK_INSTALL.length}`} role="group" aria-label={t("hero-install-title")}>
          {
            QUICK_INSTALL.map((way, i) => (
              <>
                <input type="radio" name="hero-install" id={`hero-install-${way.id}`} class="sr-only" checked={i === 0} />
                <label for={`hero-install-${way.id}`} class="hero-tab cursor-pointer rounded-sm px-2.5 py-1 text-ink-muted hover:text-ink">
                  {way.label}
                </label>
                <CopyCommand t={t} command={way.command} class="hero-way mt-2" />
              </>
            ))
          }
        </div>

        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs text-ink-muted">
          {facts.map((id) => <li>{t(id)}</li>)}
        </ul>
      </div>
    </div>

    <!-- the character, in a short exchange that loops -->
    <div class="hero-stage relative lg:col-span-5" data-hero-stage>
      
      <div class="relative mx-auto flex max-w-[26rem] flex-col gap-3 pt-2">
        <p class="hero-ask bubble-ask self-end" data-beat="ask">
          <span class="bubble-who">{t("hero-ask-who")}</span>
          {t("hero-ask")}
        </p>
        <p class="hero-say bubble-say self-start" data-beat="say">{t("hero-say")}</p>
        <div class="relative mt-2 flex justify-center">
          <!-- a soft dithered disc behind it: atmosphere, never on its body -->
          <Dither
            shape="vignette"
            from={0.16}
            to={0}
            dot={3}
            class="hero-disc absolute top-1/2 left-1/2 size-[18rem] -translate-x-1/2 -translate-y-[46%] overflow-hidden rounded-full text-ink/[0.16]"
          />
          <Nestor state="idle" look="right" size={224} class="hero-nestor relative" id="hero-nestor" label={t("nestor-label")} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* the install tabs: labels on the first row, the checked radio's commands under them */
  .hero-install {
    display: grid;
    grid-template-columns: repeat(var(--ways, 2), max-content) 1fr;
    justify-content: start;
    column-gap: 0.25rem;
  }
  .hero-tab {
    grid-row: 1;
  }
  .hero-install :global(.hero-way) {
    grid-row: 2;
    grid-column: 1 / -1;
  }
  .hero-install input:not(:checked) + .hero-tab + :global(.hero-way) {
    display: none;
  }
  .hero-install input:checked + .hero-tab {
    background: var(--color-paper-sunken);
    color: var(--color-ink);
  }
  .hero-install input:focus-visible + .hero-tab {
    outline: 2px solid var(--color-ember);
    outline-offset: 2px;
  }
  .hero-line {
    animation: rise 900ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 90ms + 60ms);
  }
  .hero-after {
    animation: fade 900ms var(--ease-out) 380ms both;
  }
  .hero-stage {
    animation: fade 900ms var(--ease-out) 200ms both;
  }
  .hero-ask,
  .hero-say {
    transition:
      opacity 420ms var(--ease-out),
      transform 420ms var(--ease-out);
  }
  /* the loop, driven by the site script; without it (or with reduced motion) both lines show */
  .hero-stage[data-phase] [data-beat] {
    opacity: 0;
    transform: translateY(8px);
  }
  .hero-stage[data-phase="ask"] [data-beat="ask"],
  .hero-stage[data-phase="think"] [data-beat="ask"],
  .hero-stage[data-phase="say"] [data-beat] {
    opacity: 1;
    transform: none;
  }
  /* a finger circling around it is read by the page (see live.ts), not taken as a scroll */
  .hero-stage :global(.hero-nestor) {
    touch-action: none;
  }
  @media (max-width: 1023px) {
    .hero-stage :global(.hero-nestor) {
      width: 144px;
      height: 144px;
    }
  }
</style>
