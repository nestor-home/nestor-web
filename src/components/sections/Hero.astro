---
import { ArrowDown } from "lucide-react";
import Dither from "@/components/Dither.astro";
import Nestor from "@/components/Nestor.astro";
import { href, type Translator } from "@/i18n";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
const lines = ["hero-line-1", "hero-line-2", "hero-line-3"];
---

<section class="hero relative overflow-hidden" aria-labelledby="hero-title" data-dock-after>
  <div class="wrap grid items-center gap-10 pt-12 pb-20 sm:pt-16 lg:grid-cols-12 lg:gap-8 lg:pt-20 lg:pb-28">
    <div class="lg:col-span-7">
      <h1 id="hero-title" class="display-1 display-hero text-ink">
        {
          lines.map((id, i) => (
            <span class="hero-line block" style={`--i:${i}`}>
              {t(id)}
            </span>
          ))
        }
      </h1>
      <div class="hero-after mt-8 md:mt-10">
        <p class="lede">{t("hero-lede")}</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#story" class="btn btn-ink" data-dock-follow={t("char-follow")}>
            {t("hero-story")}
            <ArrowDown className="size-4" strokeWidth={1.6} aria-hidden="true" />
          </a>
          <a href={href(t.locale, "docs")} class="btn btn-line">{t("hero-install")}</a>
        </div>
        <p class="mt-6 font-mono text-[0.75rem] text-ink-muted">{t("hero-note")}</p>
      </div>
    </div>

    <!-- the character, in a short exchange that loops -->
    <div class="hero-stage relative lg:col-span-5" data-hero-stage>
      
      <div class="relative mx-auto flex max-w-[26rem] flex-col gap-3 pt-2">
        <p class="hero-ask bubble-ask self-end" data-beat="ask">
          <span class="bubble-who">{t("hero-ask-who")}</span>
          {t("hero-ask")}
        </p>
        <p class="hero-say bubble-say self-start" data-beat="say">{t("hero-say")}</p>
        <div class="relative mt-2 flex justify-center">
          <!-- a soft dithered disc behind it: atmosphere, never on its body -->
          <Dither
            shape="vignette"
            from={0.16}
            to={0}
            dot={3}
            class="hero-disc absolute top-1/2 left-1/2 size-[18rem] -translate-x-1/2 -translate-y-[46%] overflow-hidden rounded-full text-ink/[0.16]"
          />
          <Nestor state="idle" look="right" size={224} class="hero-nestor relative" id="hero-nestor" label={t("nestor-label")} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-line {
    animation: rise 900ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 90ms + 60ms);
  }
  .hero-after {
    animation: fade 900ms var(--ease-out) 380ms both;
  }
  .hero-stage {
    animation: fade 900ms var(--ease-out) 200ms both;
  }
  .hero-ask,
  .hero-say {
    transition:
      opacity 420ms var(--ease-out),
      transform 420ms var(--ease-out);
  }
  /* the loop, driven by the site script; without it (or with reduced motion) both lines show */
  .hero-stage[data-phase] [data-beat] {
    opacity: 0;
    transform: translateY(8px);
  }
  .hero-stage[data-phase="ask"] [data-beat="ask"],
  .hero-stage[data-phase="think"] [data-beat="ask"],
  .hero-stage[data-phase="say"] [data-beat] {
    opacity: 1;
    transform: none;
  }
  /* a finger circling around it is read by the page (see live.ts), not taken as a scroll */
  .hero-stage :global(.hero-nestor) {
    touch-action: none;
  }
  @media (max-width: 1023px) {
    .hero-stage :global(.hero-nestor) {
      width: 144px;
      height: 144px;
    }
  }
</style>
