---
import { ArrowRight, Bot, MonitorSmartphone } from "lucide-react";
import Brand from "@/components/Brand.astro";
import Nestor from "@/components/Nestor.astro";
import { href, type Translator } from "@/i18n";
import { REPOS } from "@/lib/site";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
const lines = ["hero-line-1", "hero-line-2", "hero-line-3"];
const facts = ["hero-fact-license", "hero-fact-python", "hero-fact-sdks"];
---

<section class="hero relative overflow-hidden" aria-labelledby="hero-title">
  <div class="wrap grid items-center gap-x-10 gap-y-8 pt-12 pb-16 sm:pt-16 lg:grid-cols-12 lg:pt-20 lg:pb-24">
    <!-- on a phone: the title, Nestor and its bodies, then the rest; side by side from lg -->
    <h1 id="hero-title" class="display-1 display-hero text-ink lg:col-span-6 lg:col-start-1 lg:row-start-1 lg:self-end">
      {lines.map((id) => <span class="block">{t(id)}</span>)}
    </h1>
    <!-- one agent, its bodies around it: a speaker that heard Léa, a robot, a screen, a phone far from home -->
    <div class="hero-stage lg:col-span-6 lg:col-start-7 lg:row-span-2 lg:row-start-1" data-reveal aria-hidden="true">
      <svg class="hero-links" viewBox="0 0 100 100" preserveAspectRatio="none">
        <path d="M50 52 L22 18" />
        <path d="M50 52 L80 16" />
        <path d="M50 52 L20 82" />
        <path d="M50 52 L78 84" />
      </svg>
      <span class="hero-glow"></span>
      <div class="hero-nestor">
        <Nestor state="speaking" look="left" size={168} />
      </div>

      <div class="hero-obj hero-voice" style="--i:0" data-stagger>
        <p class="hero-obj-where"><Brand brand="satellites" class="size-3.5" decorative />{t("hero-voice-where")}</p>
        <p class="hero-wave">{[4, 8, 13, 9, 15, 11, 6, 10, 5].map((h) => <span style={`--h:${h}`} />)}</p>
        <p class="hero-voice-said">{t("hero-voice-said")}</p>
        <p class="hero-who">{t("hero-voice-who")}</p>
      </div>

      <div class="hero-obj hero-screen" style="--i:1" data-stagger>
        <p class="hero-obj-where"><MonitorSmartphone className="size-3.5" strokeWidth={1.7} />{t("hero-screen-where")}</p>
        <p class="hero-screen-text">{t("hero-screen-text")}</p>
      </div>

      <div class="hero-obj hero-robot" style="--i:2" data-stagger>
        <span class="icon-tile" style="--tile: 2.8em"><Bot className="size-6" strokeWidth={1.6} /></span>
        <span>
          <span class="block font-medium text-ink">{t("hero-robot-name")}</span>
          <span class="block text-xs text-ink-muted">{t("hero-robot-does")}</span>
        </span>
      </div>

      <div class="hero-obj hero-note" style="--i:3" data-stagger>
        <p class="hero-note-app"><Brand brand="telegram" class="size-3.5" decorative />{t("hero-note-app")}</p>
        <p class="hero-note-text">{t("hero-note-text")}</p>
      </div>
    </div>

    <div class="lg:col-span-6 lg:col-start-1 lg:row-start-2 lg:self-start">
      <p class="lede">{t("hero-lede")}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={href(t.locale, "docs")} class="btn btn-ink">
          {t("hero-start")}
          <ArrowRight className="size-4" strokeWidth={1.6} aria-hidden="true" />
        </a>
        <a href={REPOS.nestor} class="btn btn-line">
          <Brand brand="github" class="size-4" decorative />
          {t("nav-github")}
        </a>
      </div>
      <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-ink-muted">
        {facts.map((id) => <li>{t(id)}</li>)}
      </ul>
    </div>

  </div>
</section>

<style>
  /* the stage: everything placed in percent of a square-ish box, sized by its own width */
  .hero-stage {
    --at: 250ms;
    --step: 180ms;
    --rise: 10px;
    position: relative;
    container-type: inline-size;
    width: 100%;
    max-width: 36rem;
    aspect-ratio: 1 / 0.95;
    margin-inline: auto;
  }
  .hero-links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .hero-links path {
    fill: none;
    stroke: var(--ember);
    stroke-width: 0.35;
    stroke-dasharray: 0.4 1.6;
    stroke-linecap: round;
    vector-effect: none;
    opacity: 0.7;
  }
  .hero-glow {
    position: absolute;
    left: 50%;
    top: 52%;
    width: 62cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--ember-soft), transparent);
    translate: -50% -50%;
  }
  .hero-nestor {
    position: absolute;
    left: 50%;
    top: 52%;
    width: 36cqw;
    translate: -50% -50%;
  }
  .hero-nestor :global(svg) {
    width: 100%;
    height: auto;
  }

  .hero-obj {
    position: absolute;
    font-size: clamp(0.7rem, 2.6cqw, 0.9rem);
    box-shadow: var(--float);
  }
  .hero-obj-where {
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.85em;
    color: var(--ink-muted);
  }

  /* the speaker in the kitchen: who spoke, what it heard */
  .hero-voice {
    left: 0;
    top: 2%;
    width: 44cqw;
    padding: 1em 1.1em 1.1em;
    border-radius: 1.2em;
    background: radial-gradient(120% 90% at 50% 0%, var(--device-glow), var(--device) 70%);
    color: var(--device-text);
    color-scheme: dark;
    box-shadow: 0 24px 50px -24px rgb(20 14 8 / 0.6);
  }
  .hero-voice .hero-obj-where {
    color: rgb(243 236 223 / 0.6);
  }
  .hero-wave {
    display: flex;
    height: 2.4em;
    align-items: center;
    gap: 0.22em;
    margin-block: 0.6em;
  }
  .hero-wave span {
    width: 0.22em;
    height: calc(var(--h) * 0.14em + 0.2em);
    border-radius: 999px;
    background: var(--ember);
  }
  .hero-voice-said {
    font-family: var(--font-display);
    font-size: 1.35em;
    line-height: 1.15;
  }
  .hero-who {
    display: inline-block;
    margin-top: 0.7em;
    padding: 0.25em 0.6em;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    font-size: 0.82em;
    color: rgb(243 236 223 / 0.85);
  }

  /* a screen by the door, showing what it was told to show */
  .hero-screen {
    right: 0;
    top: 0;
    width: 38cqw;
    padding: 0.9em 1em 1em;
    border-radius: 1em;
    border: 0.45em solid var(--device);
    background: var(--paper-raised);
  }
  .hero-screen-text {
    margin-top: 0.4em;
    font-family: var(--font-display);
    font-size: 1.2em;
    line-height: 1.15;
    color: var(--ink);
  }

  /* a robot in the living room */
  .hero-robot {
    left: 2%;
    bottom: 4%;
    display: flex;
    width: 42cqw;
    align-items: center;
    gap: 0.75em;
    padding: 0.8em 1em;
    border-radius: 1.1em;
    background: var(--paper-raised);
  }

  /* and Léa's phone, out of the house */
  .hero-note {
    right: 0;
    bottom: 2%;
    width: 46cqw;
    padding: 0.8em 1em 0.9em;
    border-radius: 1.1em;
    background: var(--paper-raised);
  }
  .hero-note-app {
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.82em;
    color: var(--ink-muted);
  }
  .hero-note-text {
    margin-top: 0.35em;
    color: var(--ink);
    line-height: 1.35;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero-stage .hero-links {
      opacity: 0;
      transition: opacity 900ms var(--ease-out) 900ms;
    }
    :global(.js) .hero-stage[data-shown] .hero-links {
      opacity: 1;
    }
  }
</style>
