---
import { ArrowRight } from "lucide-react";
import Brand from "@/components/Brand.astro";
import Dither from "@/components/Dither.astro";
import Shot from "@/components/Shot.astro";
import type { Translator } from "@/i18n";
import { REPOS } from "@/lib/site";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
const lines = ["hero-line-1", "hero-line-2", "hero-line-3"];
const facts = ["hero-fact-1", "hero-fact-2", "hero-fact-3"];
const tail: { at: string; kind: string; text: string }[] = [
  { at: "19:08", kind: "story-kind-presence", text: "hero-tail-1" },
  { at: "19:09", kind: "story-kind-conversation", text: "hero-tail-2" },
  { at: "19:09", kind: "hero-kind-tool", text: "hero-tail-3" },
  { at: "19:11", kind: "hero-kind-task", text: "hero-tail-4" },
  { at: "19:12", kind: "story-kind-watch", text: "hero-tail-5" },
  { at: "19:14", kind: "hero-kind-memory", text: "hero-tail-6" },
  { at: "19:15", kind: "story-kind-delivery", text: "hero-tail-7" },
  { at: "19:17", kind: "story-kind-conversation", text: "hero-tail-8" },
];
---

<section class="hero relative" aria-labelledby="hero-title">
  <div class="wrap pt-14 sm:pt-20 lg:pt-28">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-end">
    <h1 id="hero-title" class="display-1 text-ink lg:col-span-7">
      {
        lines.map((id, i) => (
          <span class="hero-line block" style={`--i:${i}`}>
            {t(id)}
            {i === lines.length - 1 && <span class="cursor cursor-blink" aria-hidden="true" />}
          </span>
        ))
      }
    </h1>
    <figure class="hero-tail corner-marks border border-rule bg-paper-raised lg:col-span-5 lg:mb-3" data-tail aria-label={t("hero-tail-label")}>
      <figcaption class="flex items-center justify-between gap-3 border-b border-rule px-4 py-2.5 font-mono text-[0.68rem] text-ink-muted">
        <span class="truncate">{t("hero-tail-label")}</span>
        <span class="flex shrink-0 items-center gap-1.5 text-ember">
          <span class="live-dot inline-block size-1.5 rounded-full bg-current" aria-hidden="true"></span>
          {t("hero-tail-live")}
        </span>
      </figcaption>
      <div class="tail-window">
        <ol class="tail-list" data-tail-list>
          {
            tail.map((line) => (
              <li class="tail-line" data-kind={line.kind}>
                <time class="text-ink-muted tabular">{line.at}</time>
                <span class="tail-kind">{t(line.kind)}</span>
                <span class="min-w-0 truncate text-ink">{t(line.text)}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </figure>
    </div>
    <div class="hero-after mt-10 grid gap-10 md:mt-14 md:grid-cols-12 md:items-end">
      <div class="md:col-span-7">
        <p class="lede" set:html={t.html("hero-lede")} />
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#start" class="btn btn-ink">
            {t("hero-start")}
            <ArrowRight className="size-4" strokeWidth={1.6} aria-hidden="true" />
          </a>
          <a href={REPOS.nestor} class="btn btn-line">
            <Brand brand="github" class="size-4" decorative />
            {t("hero-code")}
          </a>
        </div>
      </div>
      <ul class="divide-y divide-rule border-y border-rule font-mono text-[0.78rem] text-ink-muted md:col-span-4 md:col-start-9">
        {
          facts.map((id) => (
            <li class="flex items-center gap-3 py-2.5">
              <span class="inline-block size-1.5 bg-ember" aria-hidden="true" />
              {t(id)}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="relative mt-16 md:mt-24">
    <Dither shape="horizon" from={0} to={0.75} dot={3} class="absolute inset-x-0 top-[12%] bottom-10 w-full text-ink/[0.13]" />
    <figure class="wrap relative">
      <div class="hero-plate plate corner-marks">
        <div class="plate-inner aspect-[16/10]">
          <Shot name="home" locale={t.locale} alt={t("hero-plate")} eager sizes="(min-width: 1216px) 1170px, 96vw" />
        </div>
      </div>
      <figcaption class="mt-3 font-mono text-[0.72rem] text-ink-muted">{t("hero-plate")}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero-line {
    animation: rise 900ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 90ms + 60ms);
  }
  .hero-tail {
    animation: fade 900ms var(--ease-out) 300ms both;
  }
  .tail-window {
    --row: 2.15rem;
    height: calc(var(--row) * 6 + 0.75rem);
    overflow: hidden;
    padding: 0.375rem 0.5rem;
    mask-image: linear-gradient(to bottom, transparent, black 1.6rem);
  }
  .tail-line {
    display: grid;
    grid-template-columns: 3rem 5.6rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: center;
    height: var(--row);
    padding-inline: 0.5rem;
    font-family: var(--font-data);
    font-size: 0.72rem;
    border-radius: 2px;
  }
  .tail-line[data-fresh] {
    animation: arrive 1.8s var(--ease) both;
  }
  .tail-kind {
    color: var(--ink-muted);
  }
  .tail-line[data-kind="story-kind-watch"] .tail-kind {
    color: var(--kind-watch);
  }
  .tail-line[data-kind="hero-kind-task"] .tail-kind {
    color: var(--kind-task);
  }
  .tail-line[data-kind="story-kind-delivery"] .tail-kind {
    color: var(--ember);
  }
  .tail-line[data-kind="story-kind-presence"] .tail-kind,
  .tail-line[data-kind="hero-kind-tool"] .tail-kind {
    color: var(--sage);
  }
  @keyframes arrive {
    from {
      background-color: var(--ember-soft);
    }
    to {
      background-color: transparent;
    }
  }
  .live-dot {
    animation: pulse-dot 2.4s var(--ease) infinite;
  }
  @keyframes pulse-dot {
    50% {
      opacity: 0.35;
    }
  }
  .hero-after {
    animation: fade 900ms var(--ease-out) 380ms both;
  }
  .hero-plate {
    animation: plate-in 1100ms var(--ease-out) 520ms both;
  }
  @keyframes plate-in {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
