---
/**
 * What Nestor plugs into, as a bento: one tile per thing a household brings (lib/integrations.ts), its logos
 * as the picture, what not shipped yet marked "planned".
 */
import Bento from "@/components/Bento.astro";
import Brand from "@/components/Brand.astro";
import Planned from "@/components/Planned.astro";
import Tile from "@/components/Tile.astro";
import type { Translator } from "@/i18n";
import { BRANDS, type Brand as BrandInfo } from "@/lib/brands";
import { INTEGRATIONS } from "@/lib/integrations";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
// each group's share of a row: a wide one beside a narrow one, the narrow side switching every row
const SPANS: Record<string, number> = { home: 5, messages: 7, mail: 7, web: 5, lists: 5, work: 7 };
---

<section id="works-with" class="section border-t border-rule" aria-labelledby="works-title">
  <div class="wrap">
    <h2 id="works-title" data-reveal class="display-2 max-w-2xl text-ink">{t("int-title")}</h2>
    <Bento class="mt-12">
      {
        INTEGRATIONS.map(({ group, items }) => (
          <Tile id={`int-${group}`} title={t(`int-group-${group}`)} text={t(`int-${group}-text`)} span={SPANS[group] ?? 6}>
            <ul class="logos" data-reveal>
              {items.map(({ brand, status }, i) => {
                const { name, hex } = BRANDS[brand] as BrandInfo;
                return (
                  <li class="logo" style={`--i:${i};${hex ? `--brand:${hex}` : ""}`}>
                    <span class="logo-mark">
                      <Brand brand={brand} class="size-6" decorative />
                    </span>
                    <span class="logo-name">{name}</span>
                    {status === "planned" && <Planned t={t} />}
                  </li>
                );
              })}
            </ul>
          </Tile>
        ))
      }
    </Bento>
    <p class="mt-8 text-sm text-ink-muted">{t("int-lede")}</p>
  </div>
</section>

<style>
  .logos {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
    gap: 0.75rem;
  }
  .logo {
    display: grid;
    min-width: 0;
    justify-items: center;
    gap: 0.45rem;
    text-align: center;
  }
  .logo-mark {
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    border-radius: 1rem;
    background: var(--paper-raised);
    box-shadow: var(--lift);
    color: var(--ink);
    transition: color var(--duration) var(--ease);
  }
  .logo:hover .logo-mark {
    color: var(--brand, var(--ink));
  }
  .logo-name {
    max-width: 100%;
    overflow-wrap: break-word;
    font-size: var(--text-xs);
    line-height: 1.3;
    color: var(--ink-muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .logos .logo {
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity 450ms var(--ease-out),
        transform 450ms var(--ease-out);
    }
    :global(.js) .logos[data-shown] .logo {
      opacity: 1;
      transform: none;
      transition-delay: calc(var(--i) * 50ms);
    }
  }
</style>
