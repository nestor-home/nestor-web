---
/**
 * What Nestor plugs into, as a bento: one tile per thing a household brings (lib/integrations.ts), its logos
 * as the picture, what not shipped yet marked "planned".
 */
import Bento from "@/components/Bento.astro";
import Brand from "@/components/Brand.astro";
import Planned from "@/components/Planned.astro";
import Tile from "@/components/Tile.astro";
import type { Translator } from "@/i18n";
import { brandOf } from "@/lib/brands";
import { INTEGRATIONS } from "@/lib/integrations";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
// each group's share of a row: a narrow one beside a wide one, the narrow side switching every row
const span = (i: number) => ((Math.floor(i / 2) + i) % 2 ? 7 : 5);
---

<section id="works-with" class="section border-t border-rule" aria-labelledby="works-title">
  <div class="wrap">
    <h2 id="works-title" data-reveal class="display-2 max-w-2xl text-ink">{t("int-title")}</h2>
    <Bento class="mt-12">
      {
        INTEGRATIONS.map(({ group, items }, i) => (
          <Tile id={`int-${group}`} title={t(`int-group-${group}`)} text={t(`int-${group}-text`)} span={span(i)}>
            <ul class="logos" data-reveal>
              {items.map(({ brand, status }, i) => {
                const { name, hex } = brandOf(brand);
                return (
                  <li class="logo" style={`--i:${i};${hex ? `--brand:${hex}` : ""}`} data-stagger>
                    <span class="logo-mark icon-tile is-raised" style="--tile: 3.5rem">
                      <Brand brand={brand} class="size-6" decorative />
                    </span>
                    <span class="logo-name">{name}</span>
                    {status === "planned" && <Planned t={t} />}
                  </li>
                );
              })}
            </ul>
          </Tile>
        ))
      }
    </Bento>
    <p class="mt-8 text-sm text-ink-muted">{t("int-lede")}</p>
  </div>
</section>

<style>
  .logos {
    --step: 50ms;
    --rise: 6px;
    display: grid;
    width: 100%;
    grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
    gap: 0.75rem;
  }
  .logo {
    display: grid;
    min-width: 0;
    justify-items: center;
    gap: 0.45rem;
    text-align: center;
  }
  .logo-mark {
    transition: color var(--duration) var(--ease);
  }
  .logo:hover .logo-mark {
    color: var(--brand, var(--ink));
  }
  .logo-name {
    max-width: 100%;
    overflow-wrap: break-word;
    font-size: var(--text-xs);
    line-height: 1.3;
    color: var(--ink-muted);
  }
</style>
