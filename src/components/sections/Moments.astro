---
/**
 * The story in four moments, each shown by the admin itself: ask once, it takes care of it, it finds the right
 * person in the right place, and one always knows why. A sequence, so each carries its number.
 */
import Shot from "@/components/Shot.astro";
import type { Translator } from "@/i18n";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
const moments = ["today", "ongoing", "house", "journal"];
---

<section id="story" class="section border-t border-rule" aria-labelledby="moments-title">
  <div class="wrap">
    <h2 id="moments-title" data-reveal class="display-2 max-w-3xl text-ink">{t("moments-title")}</h2>
    <p data-reveal class="lede mt-5">{t("moments-lede")}</p>

    <ol class="mt-14 grid gap-16 lg:mt-20 lg:gap-24">
      {
        moments.map((name, i) => (
          <li class="grid items-center gap-x-12 gap-y-6 lg:grid-cols-12">
            <div data-reveal class:list={["lg:col-span-4", i % 2 ? "lg:order-last" : ""]}>
              <p class="moment-step tabular" aria-hidden="true">
                {i + 1}
              </p>
              <h3 class="display-3 mt-3 text-ink">{t(`moment-${name}-title`)}</h3>
              <p class="mt-3 max-w-prose text-ink-muted">{t(`moment-${name}-text`)}</p>
            </div>
            <div data-reveal class="moment-shot lg:col-span-8">
              <Shot name={name} locale={t.locale} alt={t(`moment-${name}-alt`)} sizes="(min-width: 1024px) 760px, 100vw" />
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .moment-step {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  /* the admin's own screen, held like a surface of the admin */
  .moment-shot {
    overflow: hidden;
    border-radius: var(--radius-surface);
    box-shadow: var(--lift);
    background: var(--paper-raised);
  }
</style>
