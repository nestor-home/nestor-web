---
import type { Translator } from "@/i18n";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
const words = ["thesis-word-1", "thesis-word-2", "thesis-word-3", "thesis-word-4", "thesis-word-5"];
const pillars = [
  { title: "thesis-identity", text: "thesis-identity-text" },
  { title: "thesis-memory", text: "thesis-memory-text" },
  { title: "thesis-promises", text: "thesis-promises-text" },
];
---

<section class="section" aria-labelledby="thesis-title">
  <div class="wrap">
    <h2 id="thesis-title" data-reveal class="display-2 max-w-[18ch] text-ink">{t("thesis-title")}</h2>
    <p data-reveal class="mt-10 font-mono text-[0.95rem] text-ink-muted md:text-[1.05rem]">
      {t("thesis-swap-before")}
      <span data-rotator class="rotator relative mx-[0.6ch] inline-grid align-bottom text-ember" aria-hidden="true">
        {
          words.map((id, i) => (
            <span data-word data-on={i === 0 ? "" : undefined} class="rotator-word col-start-1 row-start-1">
              {t(id)}
            </span>
          ))
        }
      </span>
      <span class="sr-only">{words.map((id) => t(id)).join(", ")}</span>
      <span>{t("thesis-swap-after")}</span>
    </p>
    <dl class="mt-16 grid border-t border-rule md:grid-cols-3">
      {
        pillars.map((p, i) => (
          <div data-reveal style={`--i:${i}`} class="border-b border-rule py-7 md:border-b-0 md:py-9 md:pr-8 md:[&:not(:first-child)]:border-l md:[&:not(:first-child)]:pl-8">
            <dt class="display-3 text-ink">{t(p.title)}</dt>
            <dd class="prose-copy mt-3">{t(p.text)}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .rotator-word {
    opacity: 0;
    transform: translateY(0.4em);
    transition:
      opacity 380ms var(--ease-out),
      transform 380ms var(--ease-out);
  }
  .rotator-word[data-on] {
    opacity: 1;
    transform: none;
  }
  /* reduced motion or no script: the first word stays, the others are still read */
  :global(.no-js) .rotator-word:not([data-on]) {
    display: none;
  }
</style>
