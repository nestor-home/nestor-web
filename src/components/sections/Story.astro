---
/**
 * What Nestor does in a home, as one bento: each tile shows the thing a request leaves in the household (the
 * words said in the kitchen, the watch on the mail, the message on a phone, the bodies it speaks through, a voice
 * in the right room, the journal's trace), then the models it runs on and what stays at home. Every tile is the
 * same frame: the object on a quiet grain, then one sentence in ink and one in grey.
 */
import Bento from "@/components/Bento.astro";
import Local from "@/components/objects/Local.astro";
import Models from "@/components/objects/Models.astro";
import Phone from "@/components/objects/Phone.astro";
import Room from "@/components/objects/Room.astro";
import Satellites from "@/components/objects/Satellites.astro";
import Spoken from "@/components/objects/Spoken.astro";
import Trace from "@/components/objects/Trace.astro";
import Watch from "@/components/objects/Watch.astro";
import Tile from "@/components/Tile.astro";
import type { Translator } from "@/i18n";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
// `span`: the tile's share of a twelve-column row on a wide screen
const chapters = [
  { id: "ask", object: Spoken, span: 7 },
  { id: "watch", object: Watch, span: 5 },
  { id: "found", object: Phone, span: 5 },
  { id: "bodies", object: Satellites, span: 7 },
  { id: "reminder", object: Room, span: 6 },
  { id: "why", object: Trace, span: 6 },
  { id: "models", object: Models, span: 7 },
  { id: "local", object: Local, span: 5 },
];
---

<section id="story" class="section border-t border-rule" aria-labelledby="story-title">
  <div class="wrap">
    <div data-reveal class="max-w-2xl">
      <h2 id="story-title" class="display-2 text-ink">{t("story-title")}</h2>
      <p class="lede mt-4">{t("story-lede")}</p>
    </div>
    <Bento class="mt-12">
      {
        chapters.map(({ id, object: Object, span }) => (
          <Tile id={`story-${id}`} title={t(`story-${id}-title`)} text={t(`story-${id}-text`)} span={span}>
            <Object t={t} />
          </Tile>
        ))
      }
    </Bento>
  </div>
</section>
