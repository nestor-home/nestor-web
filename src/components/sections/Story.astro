---
/**
 * The story of one request, told by what it leaves in the household's life: the words said in the kitchen, the
 * watch that reads the mail, the message on Léa's phone, a voice in the right room, the journal's trace. One
 * object per moment, alone on its line, its words beside it.
 */
import Phone from "@/components/objects/Phone.astro";
import Room from "@/components/objects/Room.astro";
import Spoken from "@/components/objects/Spoken.astro";
import Trace from "@/components/objects/Trace.astro";
import Watch from "@/components/objects/Watch.astro";
import type { Translator } from "@/i18n";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
const chapters = [
  { id: "ask", object: Spoken },
  { id: "watch", object: Watch },
  { id: "found", object: Phone },
  { id: "reminder", object: Room },
  { id: "why", object: Trace },
];
---

<section id="story" aria-label={t("story-label")}>
  {
    chapters.map(({ id, object: Object }, i) => (
      <article class:list={["chapter", i % 2 === 1 && "is-flipped"]} aria-labelledby={`story-${id}`}>
        <div class="wrap chapter-grid">
          <div class="chapter-words" data-reveal>
            <h2 id={`story-${id}`} class="chapter-title">
              {t(`story-${id}-title`)}
            </h2>
            <p class="chapter-text">{t(`story-${id}-text`)}</p>
          </div>
          <div class="chapter-object">
            <Object t={t} />
          </div>
        </div>
      </article>
    ))
  }
</section>

<style>
  .chapter {
    padding-block: clamp(4rem, 10vw, 8rem);
  }
  .chapter + .chapter {
    border-top: 1px solid var(--rule);
  }
  .chapter-grid {
    display: grid;
    align-items: center;
    gap: 2.5rem 4rem;
  }
  .chapter-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ink);
    text-wrap: balance;
    font-variation-settings: var(--display-variation);
  }
  .chapter-text {
    max-width: 30rem;
    margin-top: 1.1rem;
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  .chapter-object {
    display: flex;
    justify-content: center;
  }
  @media (min-width: 900px) {
    .chapter-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
    .is-flipped .chapter-words {
      order: 2;
    }
  }
</style>
