---
/**
 * The guided story: Léa's parcel, from the request to the follow-up, as the demonstration
 * household's journal records it (nestor/web/src/mocks/day.ts). The steps scroll; the stage beside
 * them follows the step in the middle of the screen through one custom property, `--step`, so every
 * change is an opacity or transform transition. Without JavaScript the stage shows the last step.
 */
import { Mail, MessageCircle } from "lucide-react";
import Brand from "@/components/Brand.astro";
import type { Translator } from "@/i18n";

interface Props {
  t: Translator;
}
const { t } = Astro.props;

const TOTAL = 8;
const steps = [
  { n: 1, day: "story-yesterday", at: "20:40", quote: "story-1-quote" },
  { n: 2, day: "story-yesterday", at: "20:40" },
  { n: 3, day: "story-today", at: "17:48" },
  { n: 4, day: "story-today", at: "17:48" },
  { n: 5, day: "story-today", at: "17:48" },
  { n: 6, day: "story-today", at: "17:48", quote: "story-6-quote" },
  { n: 7, day: "story-today", at: "18:18", quote: "story-7-quote" },
  { n: 8, day: "story-today", at: "18:28", quote: "story-8-quote" },
];

type Kind = "conversation" | "watch" | "delivery" | "presence";
const journal: { from: number; at: string; kind: Kind; text: string; why?: string; yesterday?: boolean }[] = [
  { from: 1, at: "20:40", kind: "conversation", text: "story-j-1", yesterday: true },
  { from: 1, at: "20:40", kind: "watch", text: "story-j-2", yesterday: true },
  { from: 3, at: "17:48", kind: "watch", text: "story-j-3" },
  { from: 4, at: "17:48", kind: "watch", text: "story-j-4" },
  { from: 5, at: "17:48", kind: "delivery", text: "story-j-5", why: "story-5-reason" },
  { from: 6, at: "17:48", kind: "delivery", text: "story-j-6" },
  { from: 7, at: "18:12", kind: "presence", text: "story-j-7" },
  { from: 7, at: "18:18", kind: "delivery", text: "story-j-8", why: "story-7-reason" },
  { from: 7, at: "18:18", kind: "delivery", text: "story-j-9" },
  { from: 8, at: "18:28", kind: "conversation", text: "story-j-10" },
];

/* the phone: which messages show at which steps */
const messages: { from: number; until: number; who: "lea" | "richie"; text: string; at: string }[] = [
  { from: 1, until: 1, who: "lea", text: "story-1-quote", at: "20:40" },
  { from: 1, until: 1, who: "richie", text: "story-1-reply", at: "20:40" },
  { from: 8, until: 8, who: "richie", text: "story-7-quote", at: "18:18" },
  { from: 8, until: 8, who: "lea", text: "story-8-quote", at: "18:28" },
  { from: 8, until: 8, who: "richie", text: "story-8-reply", at: "18:28" },
];

const rooms = [
  { id: "salon", x: 0, y: 0, w: 280, h: 176, label: "story-room-salon" },
  { id: "cuisine", x: 280, y: 0, w: 200, h: 112, label: "story-room-cuisine" },
  { id: "bureau", x: 280, y: 112, w: 200, h: 168, label: "story-room-bureau" },
  { id: "chambre", x: 0, y: 176, w: 168, h: 104, label: "story-room-chambre" },
  { id: "entree", x: 168, y: 176, w: 112, h: 104, label: "story-room-entree" },
];
const satellites = [
  { x: 34, y: 40, room: "salon" },
  { x: 446, y: 246, room: "bureau" },
  { x: 34, y: 246, room: "chambre" },
];
---

<section id="story" class="section story" aria-labelledby="story-title" data-story data-mood="listening">
  <div class="wrap">
    <div class="max-w-3xl">
      <h2 id="story-title" data-reveal class="display-2 text-ink">{t("dev-story-title")}</h2>
      <p data-reveal class="lede mt-6">{t("dev-story-lede")}</p>
    </div>

    <div class="story-grid mt-14 lg:mt-20">
      <!-- the stage -->
      <div class="stage-wrap" aria-hidden="true">
        <div class="stage" data-stage data-step={TOTAL} style={`--step:${TOTAL}`}>
          <div class="stage-head flex items-center justify-between gap-4 border-b border-rule px-4 py-2.5">
            <span class="hidden font-mono text-[0.7rem] text-ink-muted sm:inline">{t("story-stage-label")}</span>
            <span
              class="font-mono text-[0.7rem] text-ink-muted tabular"
              data-stage-step
              data-template={t("story-step", { n: "{n}", total: TOTAL })}>{t("story-step", { n: TOTAL, total: TOTAL })}</span
            >
          </div>

          <div class="scenes relative">
            <!-- phone: the Telegram thread -->
            <div class="scene" style="--from:1;--until:1">
              <div class="phone mx-auto">
                <div class="phone-bar flex items-center gap-2 border-b border-rule px-3 py-2 font-mono text-[0.68rem] text-ink-muted">
                  <Brand brand="telegram" class="size-3.5" decorative />
                  {t("story-phone")}
                </div>
                <div class="flex flex-col gap-2 p-3">
                  {
                    messages.slice(0, 2).map((m) => (
                      <p class:list={["bubble", m.who === "lea" ? "bubble-out" : "bubble-in"]}>
                        <span>{t(m.text)}</span>
                        <time class="bubble-time">{m.at}</time>
                      </p>
                    ))
                  }
                </div>
              </div>
            </div>
            <div class="scene" style="--from:8;--until:8">
              <div class="phone mx-auto">
                <div class="phone-bar flex items-center gap-2 border-b border-rule px-3 py-2 font-mono text-[0.68rem] text-ink-muted">
                  <Brand brand="telegram" class="size-3.5" decorative />
                  {t("story-phone")}
                </div>
                <div class="flex flex-col gap-2 p-3">
                  {
                    messages.slice(2).map((m, i) => (
                      <p class:list={["bubble pop", m.who === "lea" ? "bubble-out" : "bubble-in"]} style={`--d:${i}`}>
                        <span>{t(m.text)}</span>
                        <time class="bubble-time">{m.at}</time>
                      </p>
                    ))
                  }
                </div>
              </div>
            </div>

            <!-- the watch -->
            <div class="scene" style="--from:2;--until:2">
              <dl class="card corner-marks mx-auto w-full max-w-sm font-mono text-[0.75rem]">
                <div class="flex items-center justify-between border-b border-rule px-4 py-3">
                  <dt class="text-kind-watch">{t("story-watch")}</dt>
                  <dd class="state" data-state="shipped">{t("story-watch-state")}</dd>
                </div>
                {
                  [
                    ["story-watch-owner", "story-lea", null],
                    ["story-watch-source", "story-watch-source-value", null],
                    ["story-watch-keywords", "story-watch-keywords-value", null],
                    ["story-watch-end", "story-watch-end-value", null],
                  ].map(([k, v, raw]) => (
                    <div class="grid grid-cols-[7.5rem_1fr] gap-3 px-4 py-2">
                      <dt class="text-ink-muted">{t(k as string)}</dt>
                      <dd class="text-ink">{v ? t(v as string) : raw}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>

            <!-- the mail -->
            <div class="scene" style="--from:3;--until:3">
              <div class="card mx-auto w-full max-w-sm">
                <div class="flex items-center gap-2 border-b border-rule px-4 py-2.5 font-mono text-[0.7rem] text-ink-muted">
                  <Mail className="size-3.5" strokeWidth={1.6} aria-hidden="true" />
                  <span>{t("story-mail-via")}</span>
                  <span class="text-ink-faint" aria-hidden="true">·</span>
                  <span class="truncate">{t("story-mail-from")}</span>
                </div>
                <div class="px-4 py-4">
                  <p class="font-serif text-[1.25rem] text-ink">{t("story-3-mail-subject")}</p>
                  <p class="mt-2 text-[0.88rem] leading-relaxed text-ink-muted">{t("story-3-mail-detail")}</p>
                </div>
                <div class="mail-scan h-px bg-ember"></div>
              </div>
            </div>

            <!-- triage -->
            <div class="scene" style="--from:4;--until:4">
              <ol class="triage mx-auto w-full max-w-md">
                {
                  [
                    ["story-4-rules", "story-4-rules-out", 3],
                    ["story-4-model", "story-4-model-out", 2],
                    ["story-4-agent", "story-4-agent-out", 1],
                  ].map(([name, out, width], i) => (
                    <li class="triage-row" style={`--d:${i};--w:${width}`}>
                      <span class="triage-bar" />
                      <span class="relative flex items-baseline justify-between gap-3 px-3 py-2.5">
                        <span class="text-[0.9rem] text-ink">{t(name as string)}</span>
                        <span class="font-mono text-[0.7rem] text-ink-muted">{t(out as string)}</span>
                      </span>
                    </li>
                  ))
                }
              </ol>
            </div>

            <!-- the house -->
            <div class="scene" style="--from:5;--until:7">
              <div class="house mx-auto w-full">
                <svg viewBox="-4 -4 600 288" class="block h-auto w-full" role="presentation">
                  <defs>
                    <pattern id="occupied" width="4" height="4" patternUnits="userSpaceOnUse">
                      <rect width="1.5" height="1.5" fill="currentColor"></rect>
                    </pattern>
                  </defs>
                  {
                    rooms.map((r) => (
                      <g class={`room room-${r.id}`}>
                        <rect class="room-fill" x={r.x} y={r.y} width={r.w} height={r.h} fill="url(#occupied)" />
                        <rect class="room-wall" x={r.x} y={r.y} width={r.w} height={r.h} />
                        <text x={r.x + 12} y={r.y + 20} class="room-label">
                          {t(r.label)}
                        </text>
                      </g>
                    ))
                  }
                  <!-- the front door -->
                  <line x1="210" y1="280" x2="244" y2="280" class="door"></line>
                  {
                    satellites.map((s) => (
                      <g class={`sat sat-${s.room}`} transform={`translate(${s.x} ${s.y})`}>
                        <circle r="20" class="wave wave-1" />
                        <circle r="20" class="wave wave-2" />
                        <rect x="-6" y="-6" width="12" height="12" class="sat-body" />
                      </g>
                    ))
                  }
                  <text x="54" y="44" class="sat-label">{t("story-satellite")}</text>
                  <!-- away: her phone -->
                  <g class="away" transform="translate(500 178)">
                    <rect x="0" y="0" width="92" height="74" rx="6" class="away-phone"></rect>
                    <text x="10" y="20" class="away-label">{t("story-away")}</text>
                    <rect x="10" y="32" width="70" height="10" rx="2" class="away-msg"></rect>
                    <rect x="10" y="48" width="48" height="10" rx="2" class="away-msg"></rect>
                  </g>
                  <!-- Léa -->
                  <g class="lea">
                    <circle r="7" class="lea-dot"></circle>
                    <text x="12" y="4" class="lea-label">{t("story-lea")}</text>
                  </g>
                </svg>
                <div class="house-notes mt-3 grid gap-2 font-mono text-[0.7rem] sm:grid-cols-2">
                  <p class="note flex gap-2" style="--from:5;--until:5">
                    <span class="text-ink-muted">{t("story-why")}</span>
                    <span class="text-ember">{t("story-5-reason")}</span>
                  </p>
                  <p class="note text-ink-muted" style="--from:5;--until:5">
                    {t("story-quiet")}: {t("story-quiet-value")} · {t("story-busy")}: {t("story-busy-value")}
                  </p>
                  <p class="note speech sm:col-span-2" style="--from:6;--until:6">
                    <q class="font-serif text-[1.05rem] text-ink">{t("story-6-quote")}</q>
                  </p>
                  <p class="note flex gap-2 sm:col-span-2" style="--from:7;--until:7">
                    <span class="text-ink-muted">{t("story-why")}</span>
                    <span class="text-ember">{t("story-7-reason")}</span>
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- the journal, filling up -->
          <div class="journal border-t border-rule">
            <p class="label-mono px-4 pt-3 pb-1">{t("story-journal")}</p>
            <ol class="px-2 pb-3">
              {
                journal.map((line) => (
                  <li class="jline" style={`--from:${line.from}`} data-kind={line.kind}>
                    <time class="text-ink-muted tabular">
                      {line.yesterday ? `${t("story-yesterday")} ` : ""}
                      {line.at}
                    </time>
                    <span class="jkind">{t(`story-kind-${line.kind}`)}</span>
                    <span class="min-w-0 truncate text-ink">
                      {t(line.text)}
                      {line.why && <span class="text-ember"> · {t(line.why)}</span>}
                    </span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>

      <!-- the steps -->
      <ol class="steps">
        {
          steps.map((s) => (
            <li class="step" data-step={s.n}>
              <div class="step-inner">
                <p class="flex items-center gap-3 font-mono text-[0.75rem] text-ink-muted">
                  <span class="step-dot" aria-hidden="true" />
                  <span class="tabular">
                    {t(s.day)} · {s.at}
                  </span>
                </p>
                <h3 class="display-3 mt-3">{t(`story-${s.n}-title`)}</h3>
                <p class="prose-copy mt-3" set:html={t.html(`story-${s.n}-text`)} />
                {s.quote && (
                  <blockquote class="quote mt-5 flex gap-3">
                    <MessageCircle className="mt-1 size-4 shrink-0 text-ink-faint" strokeWidth={1.6} aria-hidden="true" />
                    <p class="font-serif text-[1.15rem] leading-snug text-ink">{t(s.quote)}</p>
                  </blockquote>
                )}
                {s.n === TOTAL && (
                  <a href="#journal" class="link mt-6 inline-block font-mono text-[0.8rem]">
                    {t("story-8-link")} →
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .story-grid {
    display: grid;
    gap: 0;
  }

  /* -- the stage --------------------------------------------------------------------------- */
  .stage-wrap {
    position: sticky;
    top: 3.5rem;
    z-index: 2;
    padding-block: 0.75rem;
    background: var(--paper);
  }
  .scene,
  .note {
    --visible: clamp(0, min(var(--step) - var(--from) + 1, var(--until) - var(--step) + 1), 1);
  }
  .stage {
    border: 1px solid var(--rule);
    background: var(--paper-raised);
  }
  .scenes {
    display: grid;
    min-height: 15.5rem;
    padding: 1rem;
  }
  .scene {
    grid-area: 1 / 1;
    align-self: center;
    opacity: var(--visible);
    transform: translateY(calc((1 - var(--visible)) * 10px)) scale(calc(0.985 + var(--visible) * 0.015));
    transition:
      opacity 420ms var(--ease-out),
      transform 520ms var(--ease-out);
    pointer-events: none;
  }
  .card {
    border: 1px solid var(--rule);
    background: var(--paper);
  }

  /* phone */
  .phone {
    width: min(100%, 22rem);
    border: 1px solid var(--rule-strong);
    border-radius: 14px;
    background: var(--paper);
    overflow: hidden;
  }
  .bubble {
    position: relative;
    max-width: 85%;
    padding: 0.5rem 0.7rem 1.1rem;
    border-radius: 10px;
    font-size: 0.86rem;
    line-height: 1.4;
  }
  .bubble-out {
    align-self: flex-end;
    background: var(--ink);
    color: var(--paper);
  }
  .bubble-in {
    align-self: flex-start;
    background: var(--paper-sunken);
    color: var(--ink);
  }
  .bubble-time {
    position: absolute;
    right: 0.6rem;
    bottom: 0.25rem;
    font-size: 0.62rem;
  }
  .bubble-in .bubble-time {
    color: var(--ink-muted);
  }
  .bubble-out .bubble-time {
    opacity: 0.8;
  }
  .pop {
    transition: transform 500ms var(--ease-out);
    transition-delay: calc(var(--d) * 120ms);
  }

  /* mail */
  .mail-scan {
    transform-origin: left;
    transform: scaleX(clamp(0, var(--step) - 2, 1));
    transition: transform 900ms var(--ease-out) 200ms;
  }

  /* triage: three narrowing bars */
  .triage {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .triage-row {
    position: relative;
    border: 1px solid var(--rule);
    background: var(--paper);
  }
  .triage-bar {
    position: absolute;
    inset: 0;
    background: var(--ember-soft);
    transform-origin: left;
    transform: scaleX(calc(var(--w) / 3 * clamp(0, var(--step) - 3, 1)));
    transition: transform 700ms var(--ease-out);
    transition-delay: calc(var(--d) * 160ms + 150ms);
  }

  /* house */
  .house {
    max-width: 34rem;
  }
  .room-wall {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .room-fill {
    color: var(--ember);
    opacity: 0;
    transition: opacity 500ms var(--ease-out);
  }
  .room-label {
    font-family: var(--font-data);
    font-size: 11px;
    fill: var(--ink-muted);
  }
  .door {
    stroke: var(--paper-raised);
    stroke-width: 3;
  }
  .sat-body {
    fill: var(--ink);
  }
  .sat-label {
    font-family: var(--font-data);
    font-size: 10px;
    fill: var(--ink-muted);
  }
  .wave {
    fill: none;
    stroke: var(--ember);
    stroke-width: 1.2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .lea {
    transform: translate(150px, 110px);
    transition:
      transform 1100ms var(--ease-out),
      opacity 600ms var(--ease-out) 500ms;
  }
  .lea-dot {
    fill: var(--ember);
  }
  .lea-label {
    font-family: var(--font-data);
    font-size: 11px;
    fill: var(--ink);
  }
  .away {
    opacity: 0;
    transition: opacity 500ms var(--ease-out) 700ms;
  }
  .away-phone {
    fill: var(--paper);
    stroke: var(--rule-strong);
  }
  .away-label {
    font-family: var(--font-data);
    font-size: 10px;
    fill: var(--ink-muted);
  }
  .away-msg {
    fill: var(--sage);
    opacity: 0.55;
  }
  .note {
    opacity: var(--visible);
    transition: opacity 400ms var(--ease-out) 250ms;
  }
  .house-notes {
    display: grid;
  }
  .house-notes .note {
    grid-row: 1;
  }
  .house-notes .note.speech,
  .house-notes .note:last-child {
    grid-row: 2;
    grid-column: 1 / -1;
  }

  /* per step: presence, speech, leaving */
  [data-step="5"] .room-salon .room-fill,
  [data-step="6"] .room-salon .room-fill {
    opacity: 0.32;
  }
  [data-step="6"] .sat-salon .wave-1 {
    animation: wave 1.6s var(--ease-out) infinite;
  }
  [data-step="6"] .sat-salon .wave-2 {
    animation: wave 1.6s var(--ease-out) 0.8s infinite;
  }
  [data-step="7"] .lea {
    transform: translate(540px, 214px);
  }
  [data-step="7"] .lea-label {
    opacity: 0;
  }
  [data-step="7"] .away {
    opacity: 1;
  }
  @keyframes wave {
    from {
      opacity: 0.9;
      transform: scale(0.4);
    }
    to {
      opacity: 0;
      transform: scale(2.2);
    }
  }

  /* journal */
  .journal {
    display: none;
  }
  .jline {
    display: grid;
    grid-template-columns: 6.6rem 5.6rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.28rem 0.5rem;
    font-family: var(--font-data);
    font-size: 0.7rem;
    border-radius: 2px;
    --shown: clamp(0, var(--step) - var(--from) + 1, 1);
    --fresh: clamp(0, 1 - (var(--step) - var(--from)), 1);
    opacity: var(--shown);
    transform: translateX(calc((1 - var(--shown)) * -6px));
    transition:
      opacity 400ms var(--ease-out),
      transform 400ms var(--ease-out),
      background-color 900ms var(--ease-out);
    background: color-mix(in oklab, var(--ember-soft) calc(var(--fresh) * 100%), transparent);
  }
  .jkind {
    color: var(--ink-muted);
  }
  .jline[data-kind="watch"] .jkind {
    color: var(--kind-watch);
  }
  .jline[data-kind="delivery"] .jkind {
    color: var(--ember);
  }
  .jline[data-kind="presence"] .jkind {
    color: var(--sage);
  }
  .jline[data-kind="conversation"] .jkind {
    color: var(--kind-task);
  }

  /* -- the steps ------------------------------------------------------------------------------ */
  .step {
    display: flex;
    align-items: center;
    min-height: 78vh;
  }
  .step:first-child {
    min-height: 60vh;
  }
  .step-inner {
    max-width: 30rem;
    padding: 1.25rem 0;
  }
  /* the step being read: its title in ink and its dot lit; the others stay legible */
  .step h3 {
    color: var(--ink-muted);
    transition: color 400ms var(--ease-out);
  }
  .step[data-current] h3,
  :global(.no-js) .step h3 {
    color: var(--ink);
  }
  .step-dot {
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--ink-faint);
    transition:
      background-color 300ms var(--ease-out),
      border-color 300ms var(--ease-out);
  }
  .step[data-current] .step-dot {
    background: var(--ember);
    border-color: var(--ember);
  }
  .quote {
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 1023px) {
    .stage-wrap {
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      border-bottom: 1px solid var(--rule);
    }
    .scenes {
      min-height: 0;
      height: min(46vh, 22rem);
      padding: 0.75rem;
    }
    .house-notes {
      display: none;
    }
    .step {
      min-height: 70vh;
    }
  }

  @media (min-width: 1024px) {
    .story-grid {
