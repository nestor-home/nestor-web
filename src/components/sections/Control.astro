---
import Shot from "@/components/Shot.astro";
import type { Translator } from "@/i18n";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
const items = Array.from({ length: 8 }, (_, i) => `ctl-${i + 1}`);
---

<section class="section border-t border-rule" aria-labelledby="ctl-title" data-mood="concerned">
  <div class="wrap">
    <div class="max-w-3xl">
      <h2 id="ctl-title" data-reveal class="display-2 text-ink">{t("ctl-title")}</h2>
      <p data-reveal class="lede mt-6">{t("ctl-lede")}</p>
    </div>
    <dl class="mt-14 grid border-t border-rule md:grid-cols-2 md:gap-x-12">
      {
        items.map((id, i) => (
          <div data-reveal style={`--i:${i % 2}`} class="grid gap-2 border-b border-rule py-6 sm:grid-cols-[13rem_minmax(0,1fr)] sm:gap-6">
            <dt class="font-serif text-[1.15rem] leading-snug text-ink">{t(id)}</dt>
            <dd class="text-[0.95rem] leading-relaxed text-ink-muted">{t(`${id}-text`)}</dd>
          </div>
        ))
      }
    </dl>
    <figure data-reveal class="mt-16">
      <div class="plate corner-marks">
        <div class="plate-inner">
          <Shot name="system" locale={t.locale} alt={t("ctl-shot")} />
        </div>
      </div>
      <figcaption class="mt-3 font-mono text-[0.72rem] text-ink-muted">{t("ctl-shot")}</figcaption>
    </figure>
  </div>
</section>
