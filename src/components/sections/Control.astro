---
import Facts from "@/components/Facts.astro";
import Shot from "@/components/Shot.astro";
import type { Translator } from "@/i18n";

interface Props {
  t: Translator;
}
const { t } = Astro.props;
---

<section class="section border-t border-rule" aria-labelledby="ctl-title" data-mood="concerned">
  <div class="wrap">
    <div class="max-w-3xl">
      <h2 id="ctl-title" data-reveal class="display-2 text-ink">{t("ctl-title")}</h2>
      <p data-reveal class="lede mt-6">{t("ctl-lede")}</p>
    </div>
    <Facts t={t} prefix="ctl" count={8} />
    <figure data-reveal class="mt-16">
      <div class="plate corner-marks">
        <div class="plate-inner">
          <Shot name="system" locale={t.locale} alt={t("ctl-shot")} />
        </div>
      </div>
      <figcaption class="mt-3 font-mono text-xs text-ink-muted">{t("ctl-shot")}</figcaption>
    </figure>
  </div>
</section>
