---
/** The logo: "nestor" in the display serif, then the ember bow tie (src/character, shared with the admin). */
import "@/character/nestor.css";
import { type LogoVariant, renderLogo } from "@/character/render";

interface Props {
  class?: string;
  variant?: LogoVariant;
}
const { class: className, variant = "bow" } = Astro.props;
---

<Fragment set:html={renderLogo({ variant, ...(className ? { className } : {}) })} />
