---
/** The logo: "nestor" in the display serif, then the ember bow tie (`@nestor-home/character`). */
import { renderLogo } from "@nestor-home/character";
import "@nestor-home/character/nestor.css";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<Fragment set:html={renderLogo({ variant: "bow", ...(className ? { className } : {}) })} />
