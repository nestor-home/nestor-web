---
import Dither from "@/components/Dither.astro";
import Base from "@/layouts/Base.astro";
import { LOCALES, localePath, translator } from "@/i18n";

const pages = LOCALES.map((locale) => ({ locale, t: translator(locale) }));
---

<Base locale="en" path="/404/">
  <section class="relative overflow-hidden">
    <div class="wrap grid min-h-[70vh] content-center gap-16 py-24 md:grid-cols-2">
      {
        pages.map(({ locale, t }, i) => {
          const Heading = i === 0 ? "h1" : "h2";
          return (
          <div lang={locale}>
            <Heading class="display-2 text-ink">{t("nf-title")}</Heading>
            <p class="lede mt-6">{t("nf-text")}</p>
            <a class="btn btn-ink mt-8" href={localePath(locale, "/")}>
              {t("nf-home")}
            </a>
          </div>
          );
        })
      }
    </div>
    <Dither shape="ramp-up" from={0} to={0.45} dot={3} class="h-24 w-full text-ink/20" />
  </section>
</Base>
